entity:SetCallback("OnSpawned", function()
    print("Entity has spawned - Manually Starting Animations")
    
    local model = entity.Model
    if not model then return end

    -- Define references based on the scripts in the images
    local hrp = model:WaitForChild("HumanoidRootPart")
    local A1 = hrp:WaitForChild("A1")
    local A2 = hrp:WaitForChild("A2")
    local A1_Img = A1:FindFirstChild("ImageLabel")
    local A2_Img = A2:FindFirstChild("ImageLabel")

    --- ====== FaceChange Logic (image_d88ad7.png) ====== ---
    task.spawn(function()
        while model.Parent do
            if A1_Img.Image == "rbxassetid://11218646640" then
                A1_Img.Image = "rbxassetid://11218346472"
            elseif A1_Img.Image == "rbxassetid://11218346472" then
                A1_Img.Image = "rbxassetid://11218646640"
            end

            if A2_Img.Image == "rbxassetid://11218346472" then
                A2_Img.Image = "rbxassetid://11218646640"
            elseif A2_Img.Image == "rbxassetid://11218646640" then
                A2_Img.Image = "rbxassetid://11218346472"
            end
            task.wait(0.5)
        end
    end)

    --- ====== FaceMove Logic (image_d88ad9.png) ====== ---
    task.spawn(function()
        while model.Parent do
            task.wait(0.05)
            A1.StudsOffsetWorldSpace = Vector3.new(0, 1, 0)
            A2.StudsOffsetWorldSpace = Vector3.new(0, 1, 0)
            task.wait(0.1)
            A1.StudsOffsetWorldSpace = Vector3.new(math.random(-1, 1), math.random(0, 2), math.random(-1, 1))
            A2.StudsOffsetWorldSpace = Vector3.new(math.random(-1, 1), math.random(0, 2), math.random(-1, 1))
        end
    end)

    --- ====== FaceRotate Logic (image_d88ada.png) ====== ---
    task.spawn(function()
        while model.Parent do
            task.wait(0.05)
            if A1_Img then A1_Img.Rotation = math.random(-50, 50) end
            if A2_Img then A2_Img.Rotation = math.random(-50, 50) end
            task.wait(0.05)
            if A1_Img then A1_Img.Rotation = 0 end
            if A2_Img then A2_Img.Rotation = 0 end
        end
    end)
end)

