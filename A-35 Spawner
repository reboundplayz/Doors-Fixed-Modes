entity:SetCallback("OnDamagePlayer", function(newHealth: number)
    if newHealth <= 0 then
        print("Entity killed player")
    else
        print("Entity damaged player")
    end

    -- ====== GITHUB CONFIGURATION ====== --
    local SOUND_URL = "https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/A-35Jumpscare.mp3.mpeg"
    local IMAGE_ID = "rbxassetid://11218646640" -- Keep as rbxassetid for better performance
    local FILE_NAME = "a35_jumpscare_audio.mp3"
    -- =================================== --

    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")

    -- Create GUI
    local gui = Instance.new("ScreenGui")
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999999
    gui.ResetOnSpawn = false
    gui.Parent = playerGui

    -- Background Flash
    local flash = Instance.new("Frame")
    flash.Size = UDim2.new(1, 0, 1, 0)
    flash.BorderSizePixel = 0
    flash.BackgroundColor3 = Color3.new(0, 0, 255)
    flash.ZIndex = 10
    flash.Parent = gui

    -- Jumpscare Image
    local image = Instance.new("ImageLabel")
    image.AnchorPoint = Vector2.new(0.5, 0.5)
    image.Position = UDim2.new(0.5, 0, 0.5, 0)
    image.Size = UDim2.new(0, 300, 0, 300)
    image.BackgroundTransparency = 1
    image.Image = IMAGE_ID
    image.ZIndex = 11
    image.Parent = gui

    -- Github Sound Handler
    if not isfile(FILE_NAME) then
        writefile(FILE_NAME, game:HttpGet(SOUND_URL))
    end

    local sound = Instance.new("Sound")
    sound.SoundId = getcustomasset(FILE_NAME)
    sound.Volume = 10
    sound.Parent = gui
    sound:Play()

    -- Zoom Animation
    TweenService:Create(
        image,
        TweenInfo.new(1.2, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
        {Size = UDim2.new(0, 2500, 0, 3500)}
    ):Play()

    -- Shake and Flicker Loop
    task.spawn(function()
        local duration = 1.2
        local start = os.clock()

        while (os.clock() - start) < duration do
            -- Flicker
            flash.BackgroundColor3 = (math.random(1, 2) == 1) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(0, 0, 0)
            
            -- Shake
            image.Rotation = math.random(-5, 5)
            image.Position = UDim2.new(0.5, math.random(-25, 25), 0.5, math.random(-25, 25))

            task.wait(0.01)
        end

        gui:Destroy()
    end)
end)

