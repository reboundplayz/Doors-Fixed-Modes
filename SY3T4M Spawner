entity:SetCallback("OnSpawned", function()
    local url = "https://github.com/TheendisnearDonotfear/FearmodeDoors/raw/refs/heads/main/Syst3m_P909.mp3"
    local file = "SY3T4Msound.mp3"
    if not isfile(file) then writefile(file, game:HttpGet(url)) end

    task.spawn(function()
        local model = workspace:WaitForChild("SY3T4M", 15)
        local part = model and model:FindFirstChildWhichIsA("BasePart", true)
        if part then
            local sound = Instance.new("Sound", part)
            sound.SoundId = getcustomasset(file)
            sound.RollOffMaxDistance = 500
            sound.Volume = 2
            sound.Looped = true
            task.wait(0)
            sound:Play()
        end
    end)
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
    if firstTime then
        task.spawn(function() processRoom(room) end)
    end
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
    if newHealth <= 0 then
        triggerCustomJumpscare()
    end
end)

