---====== Room Coloring Logic ======---
local function makeCurrentRoomRed()
    local _TweenService = game:GetService('TweenService')
    local v2 = TweenInfo.new(2)
    
    -- Dynamically create the custom effect
    local _ColorCorrectionEffect = Instance.new('ColorCorrectionEffect')
    _ColorCorrectionEffect.Parent = game.Lighting
    _ColorCorrectionEffect.Brightness = 0.05
    _ColorCorrectionEffect.Contrast = 0
    _ColorCorrectionEffect.Name = 'Jen'
    _ColorCorrectionEffect.Enabled = true
    _ColorCorrectionEffect.TintColor = Color3.fromRGB(255, 255, 255)
    _ColorCorrectionEffect.Saturation = 0

    -- First flash to red (Takes 2 seconds)
    local tween1 = _TweenService:Create(_ColorCorrectionEffect, v2, {
        Contrast = 1,
        Saturation = 1,
        TintColor = Color3.fromRGB(255, 0, 0),
    })
    tween1:Play()
    tween1.Completed:Wait() 

    -- Fade back to normal (Takes 2 seconds)
    local _tween2 = _TweenService:Create(_ColorCorrectionEffect, v2, {
        Contrast = 0,
        Saturation = 0,
        TintColor = Color3.fromRGB(255, 255, 255),
        Brightness = 0,
    })
    _tween2:Play() -- FIXED: Added play call
    _tween2.Completed:Wait() -- Wait for the fade to finish completely
    
    _ColorCorrectionEffect:Destroy() -- Clean it up so it doesn't mess up original game colors!
end

---====== Asset Handling ======---

local fileName = "FireGuardianSpawn.mp3"
local soundUrl = "https://github.com/reboundplayz/Doors-Fixed-Modes/raw/main/Video%20Project%205.mp3"

-- Ensure the sound is downloaded locally
if not isfile(fileName) then
    print("Downloading sound for the first time...")
    writefile(fileName, game:HttpGet(soundUrl))
end

local function playSpawnSound()
    local success, assetId = pcall(function()
        return getcustomasset(fileName)
    end)

    if success then
        local sound = Instance.new("Sound")
        sound.SoundId = assetId
        sound.Volume = 3
        sound.Parent = game:GetService("SoundService")
        sound:Play()
        
        sound.Ended:Connect(function()
            sound:Destroy()
        end)
    else
        warn("Failed to play local asset: " .. fileName)
    end
end

