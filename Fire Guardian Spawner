local fileName = "FireGuardianSpawn.mp3"
local soundUrl = "https://github.com/reboundplayz/Doors-Fixed-Modes/raw/main/Video%20Project%205.mp3"

-- Ensure the sound is downloaded locally
if not isfile(fileName) then
    print("Downloading sound for the first time...")
    writefile(fileName, game:HttpGet(soundUrl))
end

local function playSpawnSound()
    local success, assetId = pcall(function()
        return getcustomasset(fileName)
    end)

    if success then
        local sound = Instance.new("Sound")
        sound.SoundId = assetId
        sound.Volume = 3
        sound.Parent = game:GetService("SoundService")
        sound:Play()
        
        sound.Ended:Connect(function()
            sound:Destroy()
        end)
    else
        warn("Failed to play local asset: " .. fileName)
    end
end

