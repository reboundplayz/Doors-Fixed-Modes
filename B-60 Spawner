local function forceRedTint(targetColor, duration)
    local rooms = game.Workspace:FindFirstChild("CurrentRooms")
    if not rooms then return end
    
    local originalColors = {}
    local lights = {}
    
    for _, room in pairs(rooms:GetChildren()) do
        for _, v in pairs(room:GetDescendants()) do
            if v:IsA("Light") then
                table.insert(lights, v)
                originalColors[v] = v.Color
                v.Color = targetColor
            end
        end
    end
    
    task.spawn(function()
        local start = tick()
        while tick() - start < duration do
            local elapsed = tick() - start
            local progress = elapsed / duration
            
            for _, light in ipairs(lights) do
                if light and light.Parent then
                    local orig = originalColors[light] or Color3.fromRGB(255, 255, 255)
                    light.Color = targetColor:Lerp(orig, progress)
                end
            end
            task.wait()
        end
        
        for _, light in ipairs(lights) do
            if light and light.Parent then
                light.Color = originalColors[light]
            end
        end
    end)
end

local function smoothEarthquake(duration, maxIntensity)
    local camera = game.Workspace.CurrentCamera
    local start = tick()
    local connection
    
    connection = game:GetService("RunService").RenderStepped:Connect(function()
        local elapsed = tick() - start
        if elapsed >= duration then
            connection:Disconnect()
            return
        end
        
        local currentIntensity = maxIntensity * (1 - (elapsed / duration))
        
        camera.CFrame = camera.CFrame * CFrame.Angles(
            math.rad(math.random(-currentIntensity, currentIntensity) / 10),
            math.rad(math.random(-currentIntensity, currentIntensity) / 10),
            math.rad(math.random(-currentIntensity, currentIntensity) / 10)
        )
    end)
end

