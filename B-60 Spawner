---====== Jumpscare Logic (Fast & Red) ======---

local isKilling = false
local function runHardJumpscare()
    if isKilling then return end
    isKilling = true
    local player = game.Players.LocalPlayer
    local char = player.Character
    local gui = Instance.new("ScreenGui", player.PlayerGui)
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 1000

    local s = Instance.new("Sound", game:GetService("SoundService"))
    s.SoundId = KillSoundID
    s.Volume = 3 
    s:Play()

    -- Rapid Sequential Flashes (Blood Red)
    for i = 1, 14 do
        local img = Instance.new("ImageLabel", gui)
        img.BackgroundTransparency = 1
        img.Image = FaceIDs[math.random(1, #FaceIDs)]
        img.ImageColor3 = Color3.fromRGB(255, 0, 0)
        img.Size = UDim2.new(0.8, 0, 0.8, 0)
        img.AnchorPoint = Vector2.new(0.5, 0.5)
        img.Position = UDim2.new(0.5 + math.random(-15, 15)/100, 0, 0.5 + math.random(-15, 15)/100, 0)
        img.Rotation = math.random(-45, 45)
        task.wait(0.05)
        img:Destroy()
    end

    -- Static Finale Zoom (No Cycle)
    local finalFace = Instance.new("ImageLabel", gui)
    finalFace.Image = "rbxassetid://103365774502046" 
    finalFace.ImageColor3 = Color3.fromRGB(200, 0, 0) 
    finalFace.BackgroundTransparency = 1
    finalFace.AnchorPoint = Vector2.new(0.5, 0.5)
    finalFace.Position = UDim2.new(0.5, 0, 0.5, 0)
    
    local zoomStart = tick()
    while tick() - zoomStart < 1.3 do
        local size = 0.5 + ((tick() - zoomStart) * 6.5) 
        finalFace.Size = UDim2.new(size, 0, size, 0)
        finalFace.Position = UDim2.new(0.5, math.random(-80, 80), 0.5, math.random(-80, 80))
        task.wait()
    end
    if char:FindFirstChildOfClass("Humanoid") then char:FindFirstChildOfClass("Humanoid").Health = 0 end
    char:BreakJoints()
    task.wait(0.5)
    gui:Destroy()
end

---====== Detection Logic ======---

task.spawn(function()
    while true do
        task.wait(0.05)
        if not isKilling then
            local char = game.Players.LocalPlayer.Character
            local isHiding = game.Players.LocalPlayer:GetAttribute("Hiding") == true or (char and char:FindFirstChild("Hidden"))
            local target = game.Workspace:FindFirstChild(EntityName) or game.Workspace:FindFirstChild("Entity")
            
            if char and target and not isHiding then
                local dist = (char.PrimaryPart.Position - target:GetPivot().Position).Magnitude
                if dist < 55 then runHardJumpscare() end
            end
        end
    end
end)

