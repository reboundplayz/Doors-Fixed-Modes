---====== Hardcore Jumpscare Logic ======---

local isKilling = false
local function runHardJumpscare()
    if isKilling then return end
    isKilling = true
    local player = game.Players.LocalPlayer
    local char = player.Character
    local gui = Instance.new("ScreenGui", player.PlayerGui)
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 1000

    local s = Instance.new("Sound", game:GetService("SoundService"))
    s.SoundId = KillSoundID
    s.Volume = 4 
    s:Play()

    -- Base Dark Red Background
    local backgroundFrame = Instance.new("Frame", gui)
    backgroundFrame.Size = UDim2.new(1, 0, 1, 0)
    backgroundFrame.BackgroundColor3 = Color3.fromRGB(40, 0, 0)
    backgroundFrame.BorderSizePixel = 0
    backgroundFrame.BackgroundTransparency = 1

    -- Holder for chaotic spam visuals
    local spamContainer = Instance.new("Frame", gui)
    spamContainer.Size = UDim2.new(1, 0, 1, 0)
    spamContainer.BackgroundTransparency = 1

    -- Accelerated Phase: Loops randomly spamming faces for exactly 0.8 seconds
    local phaseStart = tick()
    local spamDuration = 0.8
    
    while tick() - phaseStart < spamDuration do
        local elapsed = tick() - phaseStart
        local progress = elapsed / spamDuration
        
        local img = Instance.new("ImageLabel", spamContainer)
        img.BackgroundTransparency = 1
        img.Image = FaceIDs[math.random(1, #FaceIDs)]
        img.ImageColor3 = Color3.fromRGB(255, 0, 0)
        img.Size = UDim2.new(0.85, 0, 0.85, 0)
        img.AnchorPoint = Vector2.new(0.5, 0.5)
        img.Position = UDim2.new(0.5 + math.random(-20, 20)/100, 0, 0.5 + math.random(-20, 20)/100, 0)
        img.Rotation = math.random(-45, 45)
        
        backgroundFrame.BackgroundTransparency = math.max(0.3, 1 - progress) 
        
        task.wait(0.04)
        img:Destroy()
    end

    -- Safely wipe out spam layer so it never blocks the final display
    spamContainer:Destroy()
    backgroundFrame.BackgroundTransparency = 0.3

    -- Final static face layer (Isolated and guaranteed to draw)
    local finalFace = Instance.new("ImageLabel", gui)
    finalFace.Image = FaceIDs[math.random(1, #FaceIDs)]
    finalFace.ImageColor3 = Color3.fromRGB(220, 0, 0) 
    finalFace.BackgroundTransparency = 1 
    finalFace.ImageTransparency = 0 
    finalFace.AnchorPoint = Vector2.new(0.5, 0.5)
    finalFace.Position = UDim2.new(0.5, 0, 0.5, 0)
    finalFace.Rotation = math.random(-60, 60)
    
    local duration = 2.0 
    local zoomStart = tick()
    
    while tick() - zoomStart < duration do
        local elapsed = tick() - zoomStart
        local progress = elapsed / duration
        
        local size = 0.6 + (progress * 7.0) 
        finalFace.Size = UDim2.new(size, 0, size, 0)
        
        if progress > 0.75 then
            local fadeProgress = (progress - 0.75) / 0.25
            finalFace.ImageTransparency = fadeProgress
            backgroundFrame.BackgroundTransparency = 0.3 + (fadeProgress * 0.7)
        else
            finalFace.ImageTransparency = 0
            backgroundFrame.BackgroundTransparency = 0.3 
        end
        
        finalFace.Position = UDim2.new(0.5, math.random(-80, 80), 0.5, math.random(-80, 80))
        task.wait()
    end
    
    if char:FindFirstChildOfClass("Humanoid") then char:FindFirstChildOfClass("Humanoid").Health = 0 end
    char:BreakJoints()
    task.wait(0.4)
    gui:Destroy()
end

---====== Detection Logic ======---

task.spawn(function()
    while true do
        task.wait(0.05)
        if not isKilling then
            local player = game.Players.LocalPlayer
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            
            local isHiding = player:GetAttribute("Hiding") == true 
                or (char and char:GetAttribute("Hiding") == true)
                or (char and char:FindFirstChild("Hidden"))
            
            local target = game.Workspace:FindFirstChild(EntityName) or game.Workspace:FindFirstChild("Entity")
            
            if root and target and not isHiding then
                local entityPart = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
                if entityPart then
                    local dist = (root.Position - entityPart.Position).Magnitude
                    if dist < 55 then 
                        local rayParams = RaycastParams.new()
                        rayParams.FilterDescendantsInstances = {char, target}
                        rayParams.FilterType = Enum.RaycastFilterType.Exclude
                        
                        local direction = (root.Position - entityPart.Position)
                        local rayResult = game.Workspace:Raycast(entityPart.Position, direction, rayParams)
                        
                        if not rayResult then
                            runHardJumpscare()
                        end
                    end
                end
            end
        end
    end
end)

