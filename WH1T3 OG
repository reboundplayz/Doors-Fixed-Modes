local function wh1t3spawn()
    local _TweenService = game:GetService('TweenService')
    local v2 = TweenInfo.new(2)
    
    -- 1. Create and configure the sound
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://131489490"
    sound.Volume = 1
    sound.Parent = game.Workspace
    
    -- SKIPS THE DELAY: Starts the audio 1 second into the file
    sound.TimePosition = 0.67
    sound:Play()

    -- 2. Create the color correction effect
    local _ColorCorrectionEffect = Instance.new('ColorCorrectionEffect')
    _ColorCorrectionEffect.Parent = game.Lighting
    _ColorCorrectionEffect.Brightness = 0.05
    _ColorCorrectionEffect.Contrast = 0
    _ColorCorrectionEffect.Name = 'Jen'
    _ColorCorrectionEffect.Enabled = true
    _ColorCorrectionEffect.TintColor = Color3.fromRGB(255, 255, 255)
    _ColorCorrectionEffect.Saturation = 0

    -- 3. First flash to red (Takes 2 seconds)
    local tween1 = _TweenService:Create(_ColorCorrectionEffect, v2, {
        Contrast = 1,
        Saturation = 1,
        TintColor = Color3.fromRGB(255, 0, 0),
    })
    tween1:Play()
    tween1.Completed:Wait() 

    -- 4. Fade back to normal (Takes 2 seconds)
    local tween2 = _TweenService:Create(_ColorCorrectionEffect, v2, {
        Contrast = 0,
        Saturation = 0,
        TintColor = Color3.fromRGB(255, 255, 255),
        Brightness = 0,
    })
    tween2:Play()
    tween2.Completed:Wait() 
    
    -- 5. Delete the color effect immediately because it's done
    _ColorCorrectionEffect:Destroy()
    
    -- 6. Wait for the sound to finish its full length before destroying it
    if sound.TimeLength > 0 then
        sound.Ended:Wait()
    else
        task.wait(2)
    end
    
    sound:Destroy()
end

-- Run the function
wh1t3spawn()

