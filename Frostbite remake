local hints = {
    "You seem to have freeze'd out...",
    "Maybe something that can keep you warm?"
}

local G = getgenv()
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local frostURL = "https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/BROFROSTBITEFINISHED.rbxm"
local iciclesURL = "https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/icicles.rbxm"

-- Helper to safely create/get tint
local function getTint()
    local t = Lighting:FindFirstChild("FrostbiteTint")
    if not t then
        t = Instance.new("ColorCorrectionEffect")
        t.Name = "FrostbiteTint"
        t.TintColor = Color3.fromRGB(0, 50, 150)
        t.Contrast = 0
        t.Saturation = 0
        t.Enabled = true
        t.Parent = Lighting
    end
    return t
end

G.LoadGithubModel = function(url)
    if not (writefile and getcustomasset and request) then return nil end
    local fileName = string.match(url, "([^/]+)$") or "temp_model.rbxm"
    local response = request({Url = url, Method = "GET"})
    if response.StatusCode ~= 200 then return nil end
    writefile(fileName, response.Body)
    local assetId = getcustomasset(fileName)
    local success, result = pcall(function() return game:GetObjects(assetId)[1] end)
    return success and result or nil
end

task.spawn(function()
    -- Load Frostbite Entity
    local entity = G.LoadGithubModel(frostURL)
    if not entity then return nil end
    local model = entity:IsA("Model") and entity or entity:FindFirstChildWhichIsA("Model", true)
    
    for _, v in ipairs(model:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = false; v.CanQuery = false; v.CanTouch = false end
    end
    
    model.Parent = workspace
    local part = model:FindFirstChild("FrostyNew") or model:FindFirstChildWhichIsA("BasePart", true)
    local latestRoomVal = ReplicatedStorage.GameData.LatestRoom.Value
    local currentRoom = workspace.CurrentRooms:FindFirstChild(tostring(latestRoomVal))
    local floorPart = currentRoom and currentRoom:FindFirstChild("Parts") and currentRoom.Parts:FindFirstChild("Floor")
    
    if currentRoom and floorPart and part then
        part.CFrame = floorPart.CFrame + Vector3.new(0, 12.5, 0)
    end

    local static = model:FindFirstChild("Static Effect", true)
    local glitchParticles = model:FindFirstChild("Glitch", true)
    local close = model:FindFirstChild("close", true)
    local far = model:FindFirstChild("far", true)
    
    -- Hide features during initial forming
    local heylois = model:FindFirstChild("Heylois", true)
    local face = model:FindFirstChild("face", true)
    if heylois then heylois.Enabled = false end
    if face then face.Enabled = false end
    if glitchParticles then glitchParticles.Enabled = false end
    if close then close.Volume = 0; close:Stop() end
    if far then far.Volume = 0; far:Stop() end
    if static then static.Volume = 1; static.Looped = true; static.PlaybackSpeed = 0.112; static:Play() end

    -- Variables to hold icicle data for later reference
    local spawnedIcicles = {}
    local playerTouchedIcicle = false
    local connections = {}

    -- FORMING PHASE (6 Seconds)
    task.wait(6)

    -- MANUAL FADE IN
    local tint = getTint()
    task.spawn(function()
        for i = 1, 50 do
            tint.Contrast = tint.Contrast + 0.01
            tint.Saturation = tint.Saturation - 0.02
            task.wait(0.01)
        end
    end)

    -- Formed with face: Enable Face, Heylois, and Glitch Particles
    if heylois then heylois.Enabled = true end
    if face then face.Enabled = true end 
    if glitchParticles then glitchParticles.Enabled = true end

    if static then 
        task.spawn(function()
            for i = 1, 10 do static.Volume = static.Volume - 0.1; task.wait(0.15) end
            static:Stop() 
        end)
    end

    task.wait(0.5)
    if close then close:Play(); task.spawn(function() for i=1,10 do close.Volume = close.Volume + 0.1; task.wait(0.15) end end) end
    if far then far:Play(); task.spawn(function() for i=1,10 do far.Volume = far.Volume + 0.1; task.wait(0.15) end end) end

    -- --- ICICLE MECHANIC RUNS ONLY AFTER FORMING ---
    local iciclesContainer = G.LoadGithubModel(iciclesURL)
    if iciclesContainer and floorPart then
        local options = iciclesContainer:GetChildren()
        if #options > 0 then
            for i = 1, 4 do
                local randomSelection = options[math.random(1, #options)]
                local chosenIcicle = randomSelection:Clone()
                
                if chosenIcicle:IsA("Model") then
                    for _, p in ipairs(chosenIcicle:GetDescendants()) do
                        if p:IsA("BasePart") then
                            p.Size = p.Size * 0.6
                            p.CanCollide = false
                            p.CanTouch = true
                            p.CanQuery = true
                        end
                    end
                elseif chosenIcicle:IsA("BasePart") then
                    chosenIcicle.Size = chosenIcicle.Size * 0.6
                    chosenIcicle.CanCollide = false
                    chosenIcicle.CanTouch = true
                    chosenIcicle.CanQuery = true
                end

                local floorSize = floorPart.Size
                local rx = (math.random() - 0.5) * (floorSize.X * 0.8)
                local rz = (math.random() - 0.5) * (floorSize.Z * 0.8)
                
                local targetCF = floorPart.CFrame * CFrame.new(rx, -0.5, rz)
                local initialCF = targetCF * CFrame.new(0, -6, 0)
                
                if chosenIcicle:IsA("Model") then
                    chosenIcicle:PivotTo(initialCF)
                else
                    chosenIcicle.CFrame = initialCF
                end
                chosenIcicle.Parent = workspace

                table.insert(spawnedIcicles, {instance = chosenIcicle, start = initialCF, target = targetCF})

                local function onTouch(hit)
                    local player = Players.LocalPlayer
                    if hit and hit.Parent == player.Character then
                        local hum = hit.Parent:FindFirstChildOfClass("Humanoid")
                        if hum then
                            hum.WalkSpeed = 8
                            playerTouchedIcicle = true
                        end
                    end
                end

                if chosenIcicle:IsA("BasePart") then
                    table.insert(connections, chosenIcicle.Touched:Connect(onTouch))
                else
                    for _, p in ipairs(chosenIcicle:GetDescendants()) do
                        if p:IsA("BasePart") then
                            table.insert(connections, p.Touched:Connect(onTouch))
                        end
                    end
                end
            end

            task.spawn(function()
                for i = 1, 20 do
                    for _, data in ipairs(spawnedIcicles) do
                        if data.instance and data.instance.Parent then
                            local lerpedCFrame = data.start:Lerp(data.target, i / 20)
                            if data.instance:IsA("Model") then
                                data.instance:PivotTo(lerpedCFrame)
                            else
                                data.instance.CFrame = lerpedCFrame
                            end
                        end
                    end
                    task.wait(0.02)
                end
            end)
        end
    end

    -- Damage Loop
    local player = Players.LocalPlayer
    local active = true
    task.spawn(function()
        while active and model and model.Parent do
            local char = player.Character
            if char and char:FindFirstChild("Humanoid") then
                local hasHeat = false
                local tool = char:FindFirstChild("Lighter") or char:FindFirstChild("Candle")
                if tool then
                    for _, obj in ipairs(tool:GetDescendants()) do
                        if obj:IsA("PointLight") and obj.Enabled then hasHeat = true; break end
                    end
                end
                if not hasHeat and char.Humanoid.Health > 0 then
                    char.Humanoid:TakeDamage(10)
                    
                    -- DEATH CAUSE LOGIC ADDED HERE
                    if char.Humanoid.Health <= 0 then
                        pcall(function()
                            local playerStats = ReplicatedStorage:FindFirstChild("GameStats") and ReplicatedStorage.GameStats:FindFirstChild("Player_" .. player.Name)
                            if playerStats and playerStats:FindFirstChild("Total") and playerStats.Total:FindFirstChild("DeathCause") then
                                playerStats.Total.DeathCause.Value = "FrostBite"
                            end
                        end)
                        
                        local remote = ReplicatedStorage:FindFirstChild("Bricks", true) or ReplicatedStorage:FindFirstChild("RemotesFolder", true)
                        if remote and remote:FindFirstChild("DeathHint") then
                            firesignal(remote.DeathHint.OnClientEvent, hints)
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)

    -- Wait for room change to despawn
    ReplicatedStorage.GameData.LatestRoom.Changed:Wait()
    active = false
    
    -- DESPAWN SOUND HANDLER
    local modelDespawnSound = model:FindFirstChild("Despawn", true)
    if modelDespawnSound and modelDespawnSound:IsA("Sound") then
        local soundClone = modelDespawnSound:Clone()
        soundClone.Parent = workspace
        soundClone:Play()
        task.delay(soundClone.TimeLength + 1, function()
            soundClone:Destroy()
        end)
    end
    
    -- Disconnect touch listeners
    for _, connection in ipairs(connections) do
        if connection then connection:Disconnect() end
    end

    -- Sink icicles down
    task.spawn(function()
        for i = 1, 20 do
            for _, data in ipairs(spawnedIcicles) do
                if data.instance and data.instance.Parent then
                    local currentCF = data.instance:IsA("Model") and data.instance:GetPivot() or data.instance.CFrame
                    local lerpedCFrame = currentCF:Lerp(data.start, i / 20)
                    if data.instance:IsA("Model") then
                        data.instance:PivotTo(lerpedCFrame)
                    else
                        data.instance.CFrame = lerpedCFrame
                    end
                end
            end
            task.wait(0.02)
        end
        for _, data in ipairs(spawnedIcicles) do
            if data.instance then data.instance:Destroy() end
        end
    end)

    -- Slowly restore player speed back to normal
    task.spawn(function()
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and playerTouchedIcicle then
            while hum.WalkSpeed < 16 do
                hum.WalkSpeed = math.min(hum.WalkSpeed + 1, 16)
                task.wait(0.2)
            end
        end
    end)
    
    -- MANUAL FADE OUT
    task.spawn(function()
        local steps = 40
        local initialContrast = tint.Contrast
        local initialSaturation = tint.Saturation
        
        for i = 1, steps do
            tint.Contrast = initialContrast - (initialContrast * (i / steps))
            tint.Saturation = initialSaturation + ((0 - initialSaturation) * (i / steps))
            task.wait(0.1)
        end
        tint:Destroy()
    end)
    
    model:Destroy()
end)
