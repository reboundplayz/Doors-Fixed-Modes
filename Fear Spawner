---====== Smooth Purple Lighting ======---

local function tweenLight(light)
    local goal = {
        Color = Color3.fromRGB(150, 0, 255),
        Brightness = light.Brightness * 1.5
    }

    local tween = TweenService:Create(
        light,
        TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        goal
    )

    tween:Play()
end

local function tweenPart(part)
    local tween = TweenService:Create(
        part,
        TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {
            Color = Color3.fromRGB(150, 0, 255)
        }
    )

    tween:Play()
end

local function colorPurple(num)
    local roomsFolder = game.Workspace:FindFirstChild("CurrentRooms")
    if not roomsFolder then return end

    local r = roomsFolder:FindFirstChild(tostring(num))

    if r then
        for _, v in pairs(r:GetDescendants()) do

            if v:IsA("Light") then
                tweenLight(v)

            elseif (v:IsA("Part") or v:IsA("MeshPart"))
                and (v.Material == Enum.Material.Neon or v.Name == "LightFixture") then

                tweenPart(v)
            end
        end
    end
end

local function makeRoomsPurple()
    local latest = game.ReplicatedStorage.GameData.LatestRoom.Value
    colorPurple(latest)
    colorPurple(latest - 1)
end

---====== Universal Jumpscare ======---

local isKilling = false

local function runJumpscare(targetModel)
    if isKilling then return end
    isKilling = true

    local player = game.Players.LocalPlayer
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:FindFirstChildOfClass("Humanoid")

    local gui = Instance.new("ScreenGui")
    gui.Name = "FearJumpscare"
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999
    gui.ResetOnSpawn = false
    gui.Parent = player.PlayerGui

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BorderSizePixel = 0
    bg.ZIndex = 1
    bg.Parent = gui

    task.spawn(function()
        while bg.Parent do
            bg.BackgroundColor3 = Color3.fromRGB(120, 0, 255)
            task.wait(0.04)

            bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            task.wait(0.04)
        end
    end)

    local img = Instance.new("ImageLabel")
    img.Image = JumpscareImage
    img.BackgroundTransparency = 1
    img.AnchorPoint = Vector2.new(0.5, 0.5)
    img.Position = UDim2.new(0.5, 0, 0.5, 0)
    img.Size = UDim2.new(0, 0, 0, 0)
    img.ZIndex = 2
    img.Parent = gui

    local killSound = targetModel:FindFirstChild("Kill", true)

    if killSound then
        local s = killSound:Clone()
        s.Parent = game:GetService("SoundService")
        s.Volume = 5
        s:Play()
    end

    local start = tick()

    while tick() - start < 1.2 do
        local alpha = (tick() - start) / 1.2
        local size = 400 + (alpha * 1400)

        img.Size = UDim2.new(0, size, 0, size)
        img.Rotation = math.random(-15, 15)

        task.wait()
    end

    if hum then
        hum.Health = 0
    end

    char:BreakJoints()

    task.wait(1)

    gui:Destroy()
    isKilling = false
end

