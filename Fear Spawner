---====== Ultra-Aggressive Detection Loop ======---

task.spawn(function()
    while true do
        task.wait(0.05)

        if not isKilling then
            local player = game.Players.LocalPlayer
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")

            local isHiding = player:GetAttribute("Hiding") == true
                or (char and char:GetAttribute("Hiding") == true)
                or (char and char:FindFirstChild("Hidden"))

            if root and not isHiding then
                for _, v in pairs(game.Workspace:GetDescendants()) do
                    if v.Name == "RushNew" and v:IsA("BasePart") then
                        local dist = (root.Position - v.Position).Magnitude

                        if dist <= 50 then
                            local rayParams = RaycastParams.new()
                            rayParams.FilterDescendantsInstances = {char, v.Parent}
                            rayParams.FilterType = Enum.RaycastFilterType.Exclude

                            local ray = workspace:Raycast(
                                v.Position,
                                (root.Position - v.Position).Unit * dist,
                                rayParams
                            )

                            if not ray then
                                print("FEAR DETECTED PLAYER - TRIGGERING KILL")
                                runJumpscare(v.Parent)
                                break
                            end
                        end
                    end
                end
            end
        end
    end
end)

