---====== Exact Adapted Silent Room-Coloring Logic ======---

local function makeCurrentRoomPurple()
    -- Services
    local Players = game:GetService("Players")

    local localPlayer = Players.LocalPlayer
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart")

    -- Configuration
    local TWEEN_INFO = TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local TARGET_COLOR = Color3.fromRGB(150, 0, 255) -- Purple

    -- Helper: Find the current room the player is in
    local function getCurrentRoom()
        local workspaceRooms = workspace:FindFirstChild("CurrentRooms") or workspace:FindFirstChild("Rooms")
        if not workspaceRooms then return nil end
        
        -- Target Doors game structure specifically
        local currentRoomValue = workspace:FindFirstChild("CurrentRoom")
        if currentRoomValue and workspaceRooms:FindFirstChild(tostring(currentRoomValue.Value)) then
            return workspaceRooms[tostring(currentRoomValue.Value)]
        end
        
        -- Fallback: Find closest room based on distance
        local closestRoom = nil
        local shortestDistance = math.huge
        
        for _, room in ipairs(workspaceRooms:GetChildren()) do
            local base = room:FindFirstChild("RoomStart") or room:FindFirstChild("PrimaryPart") or room:FindFirstChildWhichIsA("BasePart")
            if base then
                local distance = (hrp.Position - base.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestRoom = room
                end
            end
        end
        return closestRoom
    end

    -- Main Execution
    local currentRoom = getCurrentRoom()

    if currentRoom then
        print("[Executor] Modifying LightStands to purple for room: " .. currentRoom.Name)
        
        -- Search specifically for the LightStand models in the current room
        for _, obj in ipairs(currentRoom:GetDescendants()) do
            if obj:IsA("Model") and obj.Name == "LightStand" then
                
                -- Go through absolutely everything inside this specific LightStand hierarchy
                for _, item in ipairs(obj:GetDescendants()) do
                    
                    -- 1. Color all dynamic light objects (handles the ones in LightFixture, Neon, and Attachments)
                    if item:IsA("Light") then
                        local lightTween = TweenService:Create(item, TWEEN_INFO, {
                            Color = TARGET_COLOR
                        })
                        lightTween:Play()
                        
                    -- 2. Color the physical visual glass/fixture parts (LightFixture and Neon)
                    elseif item:IsA("BasePart") then
                        if item.Name == "LightFixture" or item.Name == "Neon" or item.Material == Enum.Material.Neon then
                            item.Material = Enum.Material.Neon
                            
                            local partTween = TweenService:Create(item, TWEEN_INFO, {
                                Color = TARGET_COLOR
                            })
                            partTween:Play()
                        end
                    end
                    
                end
            end
        end
    else
        warn("[Executor] Could not detect the current room. Make sure you are spawned into the match.")
    end
end

---====== Universal Jumpscare ======---

local isKilling = false

local function runJumpscare(targetModel)
    if isKilling then return end
    isKilling = true

    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    local char = player.Character

    -- GUI
    local gui = Instance.new("ScreenGui")
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999999
    gui.ResetOnSpawn = false
    gui.Parent = playerGui

    -- FLASH
    local flash = Instance.new("Frame")
    flash.Size = UDim2.new(1,0,1,0)
    flash.BorderSizePixel = 0
    flash.BackgroundColor3 = Color3.new(0,0,0)
    flash.ZIndex = 10
    flash.Parent = gui

    -- IMAGE
    local image = Instance.new("ImageLabel")
    image.AnchorPoint = Vector2.new(0.5, 0.5)
    image.Position = UDim2.new(0.5, 0, 0.5, 0)
    image.Size = UDim2.new(0, 300, 0, 420)
    image.BackgroundTransparency = 1
    image.Image = JumpscareImage
    image.ZIndex = 11
    image.Parent = gui

    -- 🔊 MODEL KILL SOUND
    local killSound = targetModel:FindFirstChild("Kill", true)
    if killSound then
        local s = killSound:Clone()
        s.Parent = game:GetService("SoundService")
        s.Volume = 3
        s:Play()
    end

    -- ZOOM ANIMATION
    TweenService:Create(
        image,
        TweenInfo.new(1.2, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
        {Size = UDim2.new(0, 3500, 0, 3500)}
    ):Play()

    -- JUMPSCARE SHAKE & FLASH LOOP
    task.spawn(function()
        local duration = 1.2
        local start = os.clock()

        while true do
            local t = os.clock() - start
            if t >= duration then break end

            if math.random(1,2) == 1 then
                flash.BackgroundColor3 = Color3.fromRGB(150, 0, 255)
            else
                flash.BackgroundColor3 = Color3.fromRGB(0,0,0)
            end

            image.Rotation = math.random(-5,5)

            local offsetX = math.random(-25,25)
            local offsetY = math.random(-25,25)
            image.Position = UDim2.new(0.5, offsetX, 0.5, offsetY)

            task.wait(0.01)
        end

        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = 0 end
        if char then char:BreakJoints() end

        gui:Destroy()
        isKilling = false
    end)
end

