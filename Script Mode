local function switchPage(pageName)
    for _, p in pairs(Pages) do p.Visible = false end
    Pages[pageName].Visible = true
    
    for name, btn in pairs(categoryButtons) do
        if name == pageName then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(220, 230, 255), BackgroundTransparency = 0.3, TextColor3 = theme.Accent}):Play()
        else
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = theme.BtnDefault, BackgroundTransparency = 0.8, TextColor3 = theme.TextDim}):Play()
        end
    end
end

local function addCategoryButton(displayName, targetPage, order, isBottom)
    local CatButton = Instance.new("TextButton")
    CatButton.Name = displayName .. "Cat"
    CatButton.Size = UDim2.new(1, 0, 0, 40) -- Fills the width of the sidebar dynamically
    CatButton.Text = displayName
    CatButton.TextColor3 = theme.TextDim
    CatButton.Font = Enum.Font.GothamSemibold
    CatButton.TextSize = 12
    applyLiquidGlassStyle(CatButton, 10, 0.8)

    categoryButtons[targetPage] = CatButton

    if isBottom then
        -- Anchor perfectly to the bottom of the frame with uniform margin spacing
        CatButton.Position = UDim2.new(0, 0, 1, -40)
        CatButton.Parent = Sidebar
    else
        CatButton.LayoutOrder = order
        CatButton.Parent = TopNavFrame
    end

    CatButton.MouseButton1Click:Connect(function()
        switchPage(targetPage)
    end)
    
    if order == 1 then switchPage(targetPage) end
end

