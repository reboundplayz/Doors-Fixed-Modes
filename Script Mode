local function createPage(pageName, isCreditsPage)
    local ScrollingFrame = Instance.new("ScrollingFrame")
    ScrollingFrame.Name = pageName .. "Page"
    ScrollingFrame.Size = UDim2.new(1, -16, 1, -20)
    ScrollingFrame.Position = UDim2.new(0, 8, 0, 10)
    ScrollingFrame.BackgroundTransparency = 1
    ScrollingFrame.BorderSizePixel = 0
    ScrollingFrame.ScrollBarThickness = 4
    ScrollingFrame.ScrollBarImageColor3 = Color3.fromRGB(100, 110, 130)
    ScrollingFrame.ScrollBarImageTransparency = 0.4
    ScrollingFrame.Visible = false
    ScrollingFrame.Parent = ScriptsPanel

    if isCreditsPage then
        local ListLayout = Instance.new("UIListLayout")
        ListLayout.Padding = UDim.new(0, 10)
        ListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        ListLayout.Parent = ScrollingFrame

        ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 20)
        end)
    else
        local Grid = Instance.new("UIGridLayout")
        Grid.CellSize = UDim2.new(0, 195, 0, 56)
        Grid.CellPadding = UDim2.new(0, 12, 0, 12)
        Grid.SortOrder = Enum.SortOrder.LayoutOrder
        Grid.Parent = ScrollingFrame
        
        Grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, Grid.AbsoluteContentSize.Y + 20)
        end)
    end

    return ScrollingFrame
end

Pages.Modes = createPage("Modes", false)
Pages.Spawners = createPage("Spawners", false)
Pages.Other = createPage("Other", false)
Pages.Credits = createPage("Credits", true)

---------------------------------------------------------
-- UI CONTROLS & INTERACTION ENGINE
---------------------------------------------------------
local function addScriptButton(page, buttonText, scriptUrl)
    local TargetPage = Pages[page]
    if not TargetPage then return end

    local NewButton = Instance.new("TextButton")
    NewButton.Name = buttonText .. "Button"
    NewButton.Text = buttonText
    NewButton.TextColor3 = theme.TextMain
    NewButton.Font = Enum.Font.GothamMedium
    NewButton.TextSize = 13
    NewButton.Parent = TargetPage
    applyLiquidGlassStyle(NewButton, 12, 0.2)

    NewButton.MouseEnter:Connect(function()
        TweenService:Create(NewButton, TweenInfo.new(0.2), {BackgroundColor3 = theme.BtnHover, BackgroundTransparency = 0.1}):Play()
    end)
    NewButton.MouseLeave:Connect(function()
        TweenService:Create(NewButton, TweenInfo.new(0.2), {BackgroundColor3 = theme.BtnDefault, BackgroundTransparency = 0.2}):Play()
    end)

    NewButton.MouseButton1Click:Connect(function()
        local success, err = pcall(function()
            loadstring(game:HttpGet(scriptUrl))()
        end)
        if not success then
            warn("Execution Failed on [" .. buttonText .. "]: " .. tostring(err))
        end
    end)
end

