-- Safe wrapper for firesignal to prevent nil call crashes
local function safeFireSignal(signal, ...)
    if typeof(firesignal) == "function" then
        pcall(firesignal, signal, ...)
    else
        print("⚠️ [Rebound Debug]: firesignal is not supported by this executor.")
    end
end

G.LoadGithubAudio = function(url)
    if not (writefile and getcustomasset and request) then return nil end
    local function generateFileName(url)
        local hash = 0
        for i = 1, #url do hash = (hash * 31 + string.byte(url, i)) % 2^32 end
        return "rebound_audio_" .. tostring(hash) .. ".mp3"
    end
    local fileName = generateFileName(url)
    local success, exists = pcall(function() return isfile and isfile(fileName) end)
    if success and exists then
        local assetSuccess, assetId = pcall(function() return getcustomasset(fileName) end)
        if assetSuccess then return assetId end
    end
    local response = request({Url = url, Method = "GET"})
    if response.StatusCode ~= 200 then return nil end
    writefile(fileName, response.Body)
    local assetSuccess, assetId = pcall(function() return getcustomasset(fileName) end)
    return assetSuccess and assetId or nil
end

G.LoadGithubModel = function(url)
    print("📦 [Rebound Debug]: Loading model: " .. tostring(url))
    if not (writefile and getcustomasset and request) then return nil end
    
    local function generateFileName(url)
        local hash = 0
        for i = 1, #url do hash = (hash * 31 + string.byte(url, i)) % 2^32 end
        return "rebound_model_" .. tostring(hash) .. ".rbxm"
    end
    local fileName = generateFileName(url)
    
    local response = request({Url = url, Method = "GET"})
    if response.StatusCode ~= 200 then return nil end
    writefile(fileName, response.Body)
    
    local assetId = getcustomasset(fileName)
    local entityModel = nil
    
    local methods = {
        function() return getobjects and getobjects(assetId)[1] end,
        function() return getgenv().getobjects and getgenv().getobjects(assetId)[1] end,
        function() return game:GetObjects(assetId)[1] end
    }
    
    for i, method in ipairs(methods) do
        local success, result = pcall(method)
        if success and result and typeof(result) == "Instance" then
            print("✅ [Rebound Debug]: Model unpacked successfully using method " .. i)
            entityModel = result
            break
        end
    end
    
    if not entityModel then
        warn("⚠️ [Rebound Debug]: Executor blocked .rbxm file parsing. Generating visible fallback part.")
        entityModel = Instance.new("Model")
        entityModel.Name = "ReboundEntity"
        
        local mainPart = Instance.new("Part")
        mainPart.Name = "HumanoidRootPart"
        mainPart.Size = Vector3.new(5, 6, 5)
        mainPart.Color = Color3.fromRGB(0, 102, 255)
        mainPart.Material = Enum.Material.Neon
        mainPart.CanCollide = false
        mainPart.Anchored = true
        mainPart.Parent = entityModel
        entityModel.PrimaryPart = mainPart
    end
    
    return entityModel
end

local function Rebound(entity, isFirstRun)
    if not entity then return end
    local gameData = ReplicatedStorage:WaitForChild("GameData")
    local latestRoom = gameData:WaitForChild("LatestRoom")
    local currentRooms = workspace:WaitForChild("CurrentRooms")
    local killed = false
    local speed = 1.5
    
    local cameraShaker
    pcall(function() cameraShaker = require(ReplicatedStorage:FindFirstChild("CameraShaker")) end)
    
    local camera = workspace.CurrentCamera
    local camShake
    if cameraShaker and typeof(cameraShaker) == "table" and cameraShaker.new then
        pcall(function()
            camShake = cameraShaker.new(Enum.RenderPriority.Camera.Value, function(cf)
                camera.CFrame = camera.CFrame * cf
            end)
            camShake:Start()
        end)
    end

    local entityPart = entity.PrimaryPart or entity:FindFirstChildWhichIsA("BasePart")
    if not entityPart then return end
    
    if not workspace:GetAttribute("ReboundDirection") then
        workspace:SetAttribute("ReboundDirection", "Backward")
    end
    local currentDirection = workspace:GetAttribute("ReboundDirection")

    local function GetLastRoom()
        local targetRoomNum = latestRoom.Value + 1
        local room = currentRooms:FindFirstChild(targetRoomNum) or currentRooms:FindFirstChild(latestRoom.Value)
        return room
    end

    if isFirstRun then
        entityPart.CanCollide = false
        entityPart.Anchored = true
        
        local spawnRoom = GetLastRoom()
        if spawnRoom then
            if currentDirection == "Backward" then
                local exitPart = spawnRoom:WaitForChild("RoomExit", 3)
                if exitPart then entityPart.CFrame = exitPart.CFrame + Vector3.new(0, 0.6, 0) end
            else
                if currentRooms:FindFirstChild(1) and currentRooms[1]:FindFirstChild("RoomEntrance") then
                    entityPart.CFrame = currentRooms[1].RoomEntrance.CFrame + Vector3.new(0, 0.6, 0)
                end
            end
        end
        task.wait(4)
    end

    if workspace:FindFirstChild("SeekMovingNewClone") or workspace:FindFirstChild("SeekMoving") then return end

    local moving = entityPart:FindFirstChild("ReboundMovingSound")
    if not moving then
        local rebmoving = G.LoadGithubAudio("https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/0623(1).MP3")
        moving = Instance.new("Sound")
        moving.Name = "ReboundMovingSound"
        moving.SoundId = rebmoving or ""
        moving.Parent = entityPart
        moving.Volume = 10
        if rebmoving then moving:Play() end
    elseif not moving.IsPlaying then
        moving:Play()
    end

    local function canSeeTarget(target, size)
        if killed or workspace:FindFirstChild("SeekMovingNewClone") then return false end
        local room = latestRoom.Value
        if room == 50 or room == 100 then return false end
        
        local origin = entityPart.Position
        local direction = (target.HumanoidRootPart.Position - origin).unit * size
        local ray = Ray.new(origin, direction)
        local hit = workspace:FindPartOnRay(ray, entityPart)
        if hit and hit:IsDescendantOf(target) then
            killed = true
            return true
        end
        return false
    end

    local dmgLoop = task.spawn(function()
        while entityPart and entity and entity.Parent do task.wait(0.5)
            local v = game.Players.LocalPlayer
            if v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                if canSeeTarget(v.Character, 50) and not v.Character:GetAttribute("Hiding") then
                    if moving then moving:Stop() end
                    
                    local playerGui = v:WaitForChild("PlayerGui")
                    local staticGui = Instance.new("ScreenGui")
                    staticGui.Name = "DeerGodStaticGui"
                    staticGui.ResetOnSpawn = false
                    staticGui.IgnoreGuiInset = true
                    staticGui.DisplayOrder = 999999
                    staticGui.Parent = playerGui

                    local staticImage = Instance.new("ImageLabel")
                    staticImage.Size = UDim2.new(1.3, 0, 1.3, 0)
                    staticImage.Position = UDim2.new(0.5, 0, 0.5, 0)
                    staticImage.AnchorPoint = Vector2.new(0.5, 0.5)
                    staticImage.Image = "rbxassetid://8806708292"
                    staticImage.BackgroundTransparency = 1
                    staticImage.ImageColor3 = Color3.fromRGB(0, 100, 255)
                    staticImage.Parent = staticGui

                    local staticActive = true
                    task.spawn(function()
                        local rand = Random.new()
                        while staticActive and staticImage and staticImage.Parent do
                            staticImage.Position = UDim2.new(0.5, rand:NextNumber(-45, 45), 0.5, rand:NextNumber(-45, 45))
                            task.wait(0.015)
                        end
                    end)

                    local fileName1 = "Reboundremakeye_Jumpscare_Audio.mp3"
                    local fileName2 = "Reboundremakeye_Final_Audio.mp3"
                    
                    if not isfile(fileName1) then 
                        pcall(function() writefile(fileName1, game:HttpGet("https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/0614.mp3")) end)
                    end
                    if not isfile(fileName2) then 
                        pcall(function() writefile(fileName2, game:HttpGet("https://raw.githubusercontent.com/Francisco1692qzd/RevivedOldHardcore/main/JumpscareReb.mp3")) end)
                    end

                    local jumpSound = Instance.new("Sound", game:GetService("SoundService"))
                    jumpSound.SoundId = getcustomasset(fileName1)
                    jumpSound.Volume = 5
                    jumpSound.Looped = true
                    jumpSound:Play()

                    local finalSound = Instance.new("Sound", game:GetService("SoundService"))
                    finalSound.SoundId = getcustomasset(fileName2)
                    finalSound.Volume = 5
                    finalSound.Pitch = 0.5

                    local JUMPSCARE_DURATION = 1.75
                    local startTime = os.clock()
                    local finalPhaseStarted = false

                    local loopConnection = jumpSound.DidLoop:Connect(function() jumpSound.TimePosition = 0.25 end)
                    local finalLoopConnection = finalSound.DidLoop:Connect(function() finalSound.TimePosition = 0.25 end)

                    task.spawn(function()
                        while staticActive and not finalPhaseStarted do
                            if os.clock() - startTime < JUMPSCARE_DURATION then
                                jumpSound.Pitch = math.random(50, 150) / 100
                            end
                            task.wait(0.02)
                        end
                    end)

                    task.spawn(function()
                        local blueTintColors = {Color3.fromRGB(173, 216, 230), Color3.fromRGB(0, 0, 139)}
                        local lastImgPosition = UDim2.new(0.5, 0, 0.5, 0)
                        
                        while os.clock() - startTime < JUMPSCARE_DURATION do
                            local img = Instance.new("ImageLabel", staticGui)
                            img.Image = "rbxassetid://136737940723651"
                            img.BackgroundTransparency = 1
                            img.AnchorPoint = Vector2.new(0.5, 0.5)
                            img.ImageColor3 = blueTintColors[math.random(1, #blueTintColors)]
                            img.Size = UDim2.new(0, math.random(200, 700), 0, math.random(200, 700))
                            lastImgPosition = UDim2.new(math.random(0, 100)/100, 0, math.random(0, 100)/100, 0)
                            img.Position = lastImgPosition
                            img.Rotation = math.random(0, 360)
                            
                            task.wait(0.04)
                            img:Destroy()
                        end
                        
                        finalPhaseStarted = true
                        if loopConnection then loopConnection:Disconnect() end
                        jumpSound:Stop() jumpSound:Destroy()
                        
                        finalSound:Play()
                        
                        local finalImg = Instance.new("ImageLabel", staticGui)
                        finalImg.Image = "rbxassetid://136737940723651"
                        finalImg.BackgroundTransparency = 1
                        finalImg.AnchorPoint = Vector2.new(0.5, 0.5)
                        finalImg.Position = lastImgPosition
                        finalImg.Size = UDim2.new(0, 400, 0, 400)
                        finalImg.ImageColor3 = Color3.new(1, 0, 0)
                        
                        task.spawn(function()
                            if v.Character:FindFirstChildWhichIsA("Humanoid") then
                                v.Character:FindFirstChildWhichIsA("Humanoid"):TakeDamage(100)
                            end
                            pcall(function()
                                game.ReplicatedStorage.GameStats["Player_" .. v.Character.Name].Total.DeathCause.Value = "Rebound"
                            end)
                            
                            local hints = {
                                "You died to an entity named Rebound...",
                                "He could trick you by coming through the next doors in the next few seconds!",
                                "Whenever this happens, do not go forward, stay on your desired hiding spot!"
                            }
                            if ReplicatedStorage:FindFirstChild("RemotesFolder") then
                                safeFireSignal(ReplicatedStorage.RemotesFolder.DeathHint.OnClientEvent, hints, "Blue")
                            elseif ReplicatedStorage:FindFirstChild("Bricks") then
                                safeFireSignal(ReplicatedStorage.Bricks.DeathHint.OnClientEvent, hints)
                            end
                        end)

                        local TweenService = game:GetService("TweenService")
                        local growTween = TweenService:Create(finalImg, TweenInfo.new(1.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Position = UDim2.new(0.5, 0, 0.5, 0),
                            Size = UDim2.new(1.2, 0, 1.2, 0)
                        })
                        growTween:Play() growTween.Completed:Wait()
                        
                        if finalLoopConnection then finalLoopConnection:Disconnect() end
                        
                        local fadeInfo = TweenInfo.new(1.5, Enum.EasingStyle.Linear)
                        TweenService:Create(finalImg, fadeInfo, {ImageTransparency = 1}):Play()
                        TweenService:Create(finalSound, fadeInfo, {Volume = 0}):Play()
                        local bgFade = TweenService:Create(staticImage, fadeInfo, {ImageTransparency = 1})
                        bgFade:Play() bgFade.Completed:Wait()
                        
                        staticActive = false
                        staticGui:Destroy()
                        if camShake then pcall(function() camShake:Stop() end) end
                        finalSound:Stop() finalSound:Destroy()
                    end)
                end
            end

            if camShake and entityPart and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                if (entityPart.Position - v.Character.HumanoidRootPart.Position).Magnitude <= 60 then
                    pcall(function() camShake:ShakeOnce(14, 9, 0, 2, 1, 6) end)
                end
            end
        end
    end)

    task.wait(1)

    if currentDirection == "Backward" then
        for i = latestRoom.Value, 1, -1 do
            local room = currentRooms:FindFirstChild(i)
            local abc = room and room:FindFirstChild("RoomEntrance")
            if abc then
                local jerk = game.TweenService:Create(entityPart, TweenInfo.new(speed, Enum.EasingStyle.Sine), {CFrame = abc.CFrame + Vector3.new(0, 0.9, 0)})
                jerk:Play() jerk.Completed:Wait()
            end
        end
        workspace:SetAttribute("ReboundDirection", "Forward")
    else
        for i = 1, latestRoom.Value do
            local room = currentRooms:FindFirstChild(i)
            local abc = room and room:FindFirstChild("RoomExit")
            if abc then
                local jerk = game.TweenService:Create(entityPart, TweenInfo.new(speed, Enum.EasingStyle.Sine), {CFrame = abc.CFrame + Vector3.new(0, 0.9, 0)})
                jerk:Play() jerk.Completed:Wait()
            end
        end
        workspace:SetAttribute("ReboundDirection", "Backward")
    end

    task.cancel(dmgLoop)
end

local function RunReboundCycle()
    local rawURL = "https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/reboundfinalbropls.rbxm"
    local entity = G.LoadGithubModel(rawURL)
    
    if entity and typeof(entity) == "Instance" then
        entity.Parent = workspace
    else
        return
    end

    local isFirstRun = true
    pcall(function() Rebound(entity, isFirstRun) end)
    isFirstRun = false
    
    local rollSuccess = true
    while rollSuccess do
        task.wait(math.random(3, 5))
        if math.random(1, 100) <= 50 then
            pcall(function() Rebound(entity, isFirstRun) end)
        else
            rollSuccess = false 
        end
    end

    game.Debris:AddItem(entity, 2)
end

local function SpawnReb()
    -- WARNING AUDIO STUFF RETRIEVED HERE
    local rebarrival = G.LoadGithubAudio("https://raw.githubusercontent.com/Francisco1692qzd/RevivedOldHardcore/main/Warning.mp3")
    local arrival = Instance.new("Sound", workspace)
    arrival.SoundId = rebarrival or ""
    arrival.Volume = 5
    if rebarrival then arrival:Play() end 
    game.Debris:AddItem(arrival, 10)
    
    -- COLOR CORRECTION FLASH AND SHAKE RE-INJECTED HERE
    local cameraShaker
    pcall(function() cameraShaker = require(game.ReplicatedStorage:FindFirstChild("CameraShaker")) end)
    local camera = workspace.CurrentCamera

    if cameraShaker and typeof(cameraShaker) == "table" and cameraShaker.new then
        pcall(function()
            local warnShake = cameraShaker.new(Enum.RenderPriority.Camera.Value, function(cf)
                camera.CFrame = camera.CFrame * cf
            end)
            
            local Warn = Instance.new("ColorCorrectionEffect", game.Lighting)
            Warn.TintColor = Color3.fromRGB(65, 138, 255)
            Warn.Saturation = -0.7
            Warn.Contrast = 0.2
            
            game.TweenService:Create(Warn, TweenInfo.new(15), {
                TintColor = Color3.fromRGB(255, 255, 255),
                Saturation = 0,
                Contrast = 0
            }):Play()
            
            game.Debris:AddItem(Warn, 15)
            warnShake:Start()
            warnShake:ShakeOnce(10, 3, 0.1, 6, 2, 0.5)
        end)
    end
    
    RunReboundCycle()
    
    local doorAttackCounter = 0
    local doorConnection
    doorConnection = game.ReplicatedStorage.GameData.LatestRoom.Changed:Connect(function()
        doorAttackCounter = doorAttackCounter + 1
        if doorAttackCounter > 4 then
            if doorConnection then doorConnection:Disconnect() end
            return
        end
        
        task.spawn(function()
            local player = game.Players.LocalPlayer
            if player and player:FindFirstChild("PlayerGui") then
                local flashGui = Instance.new("ScreenGui", player.PlayerGui)
                flashGui.Name = "ReboundDoorFlash"
                flashGui.IgnoreGuiInset = true
                flashGui.DisplayOrder = 999998

                local flashFrame = Instance.new("Frame", flashGui)
                flashFrame.Size = UDim2.new(1, 0, 1, 0)
                flashFrame.BackgroundColor3 = Color3.fromRGB(0, 102, 255) 
                flashFrame.BorderSizePixel = 0

                local fadeTween = game:GetService("TweenService"):Create(flashFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1})
                fadeTween:Play() fadeTween.Completed:Wait()
                flashGui:Destroy()
            end
        end)
        
        task.wait(2) 
        RunReboundCycle()
    end)
    
    -- BADGE INITIATION CHECK REMOUNTED
    pcall(function()
        local AchievementModule = game.Players.LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game.RemoteListener.Modules.AchievementUnlock
        if AchievementModule == nil then return end
        if workspace:FindFirstChild("ReboundAchievement") then return end
        if not game.ReplicatedStorage:FindFirstChild("ModulesShared") then return end
        local unlockFunc = require(AchievementModule)
        unlockFunc(nil, "Rebound") 
        
        local ObtainedBadge = Instance.new("BoolValue", workspace)
        ObtainedBadge.Name = "ReboundAchievement"
        ObtainedBadge.Value = true
    end)
end

local finalSpawnSuccess, finalSpawnErr = pcall(SpawnReb)
if not finalSpawnSuccess then
    warn("❌ [Rebound Debug]: Main execution routine encountered an unhandled error: " .. tostring(finalSpawnErr))
end
