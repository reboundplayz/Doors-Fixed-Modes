TextLabel.Size = UDim2.new(0.4, 0, 0.8, 0) 
TextLabel.Position = UDim2.new(0.98, 0, 0.5, 0) 
TextLabel.AnchorPoint = Vector2.new(1, 0.5) 
TextLabel.BackgroundTransparency = 1
TextLabel.Font = Enum.Font.Oswald
TextLabel.TextSize = targetTextSize
TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255) -- Changes default text color to pure white
TextLabel.TextXAlignment = Enum.TextXAlignment.Center 
TextLabel.TextYAlignment = Enum.TextYAlignment.Center
TextLabel.RichText = true

-- Updated RichText format with the new text and white text overrides for brackets/labels
TextLabel.Text = [[
