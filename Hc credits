-- Parent to CoreGui so it persists and bypasses standard player GUI restrictions
if syn and syn.protect_gui then
    syn.protect_gui(ScreenGui)
    ScreenGui.Parent = CoreGui
elseif gethui then
    ScreenGui.Parent = gethui()
else
    ScreenGui.Parent = CoreGui
end

-- Animation Sequence
local fadeInInfo = TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local fadeOutInfo = TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

local fadeIn = TweenService:Create(CanvasGroup, fadeInInfo, {GroupTransparency = 0})
local fadeOut = TweenService:Create(CanvasGroup, fadeOutInfo, {GroupTransparency = 1})

-- Run Timeline
fadeIn:Play()
fadeIn.Completed:Wait()

task.wait(10) -- Hold text on screen for exactly 10 seconds

fadeOut:Play()
fadeOut.Completed:Wait()

-- Clean up
ScreenGui:Destroy()
