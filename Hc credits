local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")

-- Create the ScreenGui and protect it
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "DoorsCreditsGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Use CanvasGroup to seamlessly fade RichText without color distortion
local CanvasGroup = Instance.new("CanvasGroup")
CanvasGroup.Size = UDim2.new(1, 0, 1, 0)
CanvasGroup.BackgroundTransparency = 1
CanvasGroup.GroupTransparency = 1 -- Start fully invisible
CanvasGroup.Parent = ScreenGui

-- Determine font size based on input device
local targetTextSize = 52 -- Large size for PC users
if UserInputService.TouchEnabled then
    targetTextSize = 20 -- Smaller, scaled-down size for mobile/touch screens
end

-- Create the Credits Text Label
