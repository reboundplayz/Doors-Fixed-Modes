-- 3. Dynamic Color Shifting Logic
local function UpdateStaminaUI()
    local Percentage = CurrentStamina / MAX_STAMINA
    ProgressVisual.Size = UDim2.new(Percentage, 0, 1, 0)
    
    local targetColor
    -- Split transitions up cleanly so Blue mixes with Green instead of jumping directly to Yellow
    if Percentage > 0.75 then
        targetColor = CUSTOM_BLUE -- Custom Light Blue
    elseif Percentage > 0.50 then
        local relativePercent = (Percentage - 0.50) / 0.25
        targetColor = Color3.fromRGB(50, 255, 50):Lerp(CUSTOM_BLUE, relativePercent) -- Green to Custom Blue
    elseif Percentage > 0.25 then
        local relativePercent = (Percentage - 0.25) / 0.25
        targetColor = Color3.fromRGB(255, 230, 0):Lerp(Color3.fromRGB(50, 255, 50), relativePercent) -- Yellow to Green
    else
        local relativePercent = Percentage / 0.25
        targetColor = Color3.fromRGB(240, 40, 40):Lerp(Color3.fromRGB(255, 230, 0), relativePercent) -- Red to Yellow
    end
    
    ProgressVisual.BackgroundColor3 = targetColor
    HealthBarBorder.BackgroundColor3 = targetColor
    
    -- Make the background a darker shade of the current color for layered contrast
    BarBackground.BackgroundColor3 = targetColor:Lerp(Color3.fromRGB(0, 0, 0), 0.8)
end

-- Smooth multi-element fade function
local function FadeUI(targetTransparency)
    local tweenInfo = TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    TweenService:Create(HealthBarBorder, tweenInfo, {BackgroundTransparency = targetTransparency}):Play()
    TweenService:Create(BarBackground, tweenInfo, {BackgroundTransparency = targetTransparency}):Play()
    TweenService:Create(ProgressVisual, tweenInfo, {BackgroundTransparency = targetTransparency}):Play()
end

-- 4. Exhaustion Handling
local function ToggleExhaustion(state)
    IsExhausted = state
    if state then
        IsSprinting = false
        if Humanoid then Humanoid.WalkSpeed = EXHAUSTED_SPEED end
        
        pcall(function()
            require(MainUI.Initiator.Main_Game).caption("You're Exhausted.", true)
        end)
        
        TweenService:Create(Vignette, TweenInfo.new(0.4, Enum.EasingStyle.Sine), {ImageTransparency = 0.2}):Play()
        
        if not BreathingSound.IsPlaying then
            BreathingSound:Play()
        end
    else
        TweenService:Create(Vignette, TweenInfo.new(0.6, Enum.EasingStyle.Sine), {ImageTransparency = 1}):Play()
        BreathingSound:Stop()
        if Humanoid then Humanoid.WalkSpeed = BaseWalkSpeed end
    end
end

-- Monitor baseline speed updates safely
local function UpdateBaseSpeed()
    if Humanoid and not IsSprinting and not IsExhausted and 
       Humanoid.WalkSpeed ~= SPRINT_SPEED and 
       Humanoid.WalkSpeed ~= REGEN_SPEED and 
       Humanoid.WalkSpeed ~= EXHAUSTED_SPEED then
        BaseWalkSpeed = Humanoid.WalkSpeed
    end
end

-- 5. Inputs (PC / Mobile Split)
if UserInputService.TouchEnabled then
    local MobileControls = PlayerGui:WaitForChild("TouchGui", 5) and PlayerGui.TouchGui:WaitForChild("TouchControlFrame", 5)
    local CrouchButton = MobileControls and MobileControls:FindFirstChild("CrouchButton", true)
    
