    MobileSprint.Name = "MobileSprintButton"
    MobileSprint.BackgroundTransparency = 1
    MobileSprint.Image = MOBILE_BUTTON_IMAGE
    MobileSprint.Parent = StaminaGui
    
    if CrouchButton then
        MobileSprint.Size = UDim2.new(CrouchButton.Size.X.Scale * 1.15, 0, CrouchButton.Size.Y.Scale * 1.15, 0)
        MobileSprint.Position = UDim2.new(CrouchButton.Position.X.Scale - 0.15, 0, CrouchButton.Position.Y.Scale - 0.05, 0)
    else
        MobileSprint.Size = UDim2.new(0, 75, 0, 75)
        MobileSprint.Position = UDim2.new(0.72, 0, 0.65, 0)
    end
    
    MobileSprint.MouseButton1Click:Connect(function()
        if IsExhausted then return end
        IsSprinting = not IsSprinting
        LastActivityTime = os.clock()
    end)
else
    -- PC Keybind (Q) - Hold
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.Q and not IsExhausted then
            IsSprinting = true
            LastActivityTime = os.clock()
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Q then
            IsSprinting = false
            LastActivityTime = osclock()
        end
    end)
end

-- 6. Heartbeat Loop: Core Logic & Speeds
RunService.Heartbeat:Connect(function(dt)
    if not Humanoid or not Humanoid.Parent then
        Character = Player.Character or Player.CharacterAdded:Wait()
        Humanoid = Character:WaitForChild("Humanoid")
        BreathingSound.Parent = Character:WaitForChild("Head")
        BaseWalkSpeed = Humanoid.WalkSpeed
    end

    UpdateBaseSpeed()

    local isActivelyUsing = (IsSprinting and Humanoid.MoveDirection.Magnitude > 0) or IsExhausted

    if IsExhausted then
        Humanoid.WalkSpeed = EXHAUSTED_SPEED
        CurrentStamina = math.clamp(CurrentStamina + (STAMINA_REGEN * dt), 0, MAX_STAMINA)
        if CurrentStamina >= (MAX_STAMINA * 0.66) then
            ToggleExhaustion(false)
        end
    elseif IsSprinting and Humanoid.MoveDirection.Magnitude > 0 then
        Humanoid.WalkSpeed = SPRINT_SPEED
        CurrentStamina = math.clamp(CurrentStamina - (STAMINA_DRAIN * dt), 0, MAX_STAMINA)
        if CurrentStamina <= 0 then
            ToggleExhaustion(true)
        end
    else
        if CurrentStamina < MAX_STAMINA then
            Humanoid.WalkSpeed = REGEN_SPEED
            CurrentStamina = math.clamp(CurrentStamina + (STAMINA_REGEN * dt), 0, MAX_STAMINA)
            isActivelyUsing = true -- Keep UI active during active regeneration
        else
            Humanoid.WalkSpeed = BaseWalkSpeed
        end
    end
    
    -- Activity & Fade Timer Checks
    if isActivelyUsing then
        LastActivityTime = os.clock()
        if IsFadedOut then
            IsFadedOut = false
            FadeUI(0) -- Restores back to full visibility smoothly
        end
    else
        if os.clock() - LastActivityTime >= FADE_DELAY and not IsFadedOut then
            IsFadedOut = true
            FadeUI(IDLE_TRANSPARENCY) -- Fades out slightly instead of completely hiding
        end
    end
    
    UpdateStaminaUI()
end)

-- 7. RenderStepped Camera Override
RunService.RenderStepped:Connect(function(dt)
    Camera = workspace.CurrentCamera
    
    local desiredFOV = NORMAL_FOV
    if IsSprinting and Humanoid and Humanoid.MoveDirection.Magnitude > 0 and not IsExhausted then
        desiredFOV = SPRINT_FOV
    end
    
    CurrentFOV = math.clamp(CurrentFOV + (desiredFOV - CurrentFOV) * (dt / FOV_TWEEN_TIME), NORMAL_FOV, SPRINT_FOV)
    Camera.FieldOfView = CurrentFOV
end)
