entity:SetCallback("OnDamagePlayer", function(newHealth: number)
    if newHealth <= 0 then
        print("Entity has killed the player")
        
        local JUMPSCARE_IMAGES = {
            "rbxassetid://124887042598105",
            "rbxassetid://17206102313",
            "rbxassetid://70579374116007",
            "rbxassetid://138308786963210",
            "rbxassetid://107134253330756",
            "rbxassetid://138806755053926",
            "rbxassetid://83021870514358",
            "rbxassetid://133426336717195",
            "rbxassetid://129072942715997",
            "rbxassetid://81268093333511"
        }

        local JUMPSCARE_AUDIO_URL = "https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/HAIR%20JUMPSCARE%20(1)%20(1).mp3"
        local AUDIO_FILE_NAME = "asixtyScareremakeOmg"
        local JUMPSCARE_DURATION = 0.85 

        local function loadCustomSound(url, fileName)
            if not isfile(fileName .. '.mp3') then
                writefile(fileName .. '.mp3', game:HttpGet(url))
            end

            local sound = Instance.new('Sound')
            sound.SoundId = (getcustomasset or getsynasset)(fileName .. '.mp3')
            return sound
        end

        local function runJumpscare()
            print('Executing Jumpscare...')

            local player = game.Players.LocalPlayer
            local character = player.Character or player.CharacterAdded:Wait()
            local humanoid = character:FindFirstChildOfClass('Humanoid')
            
            if not humanoid then return end

            local screenGui = Instance.new('ScreenGui')
            screenGui.Parent = player:WaitForChild('PlayerGui')
            screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

            local fullTemplate = Instance.new('ImageLabel')
            fullTemplate.Name = 'Full'
            fullTemplate.Parent = screenGui
            fullTemplate.BackgroundTransparency = 1
            fullTemplate.Position = UDim2.new(-0.0609865487, 0, -0.224358946, 0)
            fullTemplate.Size = UDim2.new(1.12197304, 0, 1.44743586, 0)
            fullTemplate.ImageTransparency = 1

            local jumpscareEnd = Instance.new('ImageLabel')
            jumpscareEnd.Name = 'JumpscareEnd'
            jumpscareEnd.Parent = screenGui
            jumpscareEnd.BackgroundTransparency = 1
            
            local defaultPosition = UDim2.new(0.468161434, 0, 0.455128193, 0)
            local defaultSize = UDim2.new(0.0636771321, 0, 0.0884615406, 0)
            
            jumpscareEnd.Position = defaultPosition
            jumpscareEnd.Size = defaultSize
            jumpscareEnd.ImageColor3 = Color3.fromRGB(255, 0, 4)

            local finalFace = JUMPSCARE_IMAGES[math.random(1, #JUMPSCARE_IMAGES)]
            local scareSound = loadCustomSound(JUMPSCARE_AUDIO_URL, AUDIO_FILE_NAME)
            scareSound.Parent = workspace
            scareSound.Volume = 6
            scareSound.PlayOnRemove = false

            local lighting = game:GetService("Lighting")
            local colorCorrection = Instance.new('ColorCorrectionEffect', lighting)

            scareSound:Play()

            game:GetService("TweenService"):Create(colorCorrection, TweenInfo.new(0.5), {
                Brightness = 0.2,
                Contrast = 0.2,
                Saturation = -0.2,
                TintColor = Color3.fromRGB(255, 0, 4),
            }):Play()

            local cycling = true
            task.spawn(function()
                local rng = Random.new()
                while cycling do
                    jumpscareEnd.Image = JUMPSCARE_IMAGES[math.random(1, #JUMPSCARE_IMAGES)]
                    local randomX = rng:NextNumber(0.1, 0.8)
                    local randomY = rng:NextNumber(0.1, 0.8)
                    jumpscareEnd.Position = UDim2.new(randomX, 0, randomY, 0)
                    jumpscareEnd.Size = UDim2.new(0.15, 0, 0.2, 0)
                    jumpscareEnd.Rotation = rng:NextNumber(-180, 180)
                    
                    game:GetService("RunService").Heartbeat:Wait()
                    task.wait(math.random(0, 1) / 100) 
                end
            end)

            task.wait(JUMPSCARE_DURATION)
            cycling = false 
            
            jumpscareEnd.Image = finalFace
            jumpscareEnd.Position = defaultPosition
            jumpscareEnd.Size = defaultSize
            jumpscareEnd.Rotation = 0

            game:GetService("TweenService"):Create(jumpscareEnd, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = fullTemplate.Size,
                Position = fullTemplate.Position,
                Rotation = math.random(-25, 25),
            }):Play()

            game:GetService("TweenService"):Create(colorCorrection, TweenInfo.new(2), {
                Brightness = 0,
                Contrast = 0,
                Saturation = 0,
                TintColor = Color3.fromRGB(255, 255, 255),
            }):Play()

            humanoid:TakeDamage(100)

            task.wait(1.5)
            game:GetService("TweenService"):Create(jumpscareEnd, TweenInfo.new(0.5), {ImageTransparency = 1}):Play()
            
            task.delay(0.5, function()
                screenGui:Destroy()
                colorCorrection:Destroy()
                scareSound:Destroy()
            end)
        end

        runJumpscare()
    else
        print("Entity has damaged the player")
    end
end)

