entity:SetCallback("OnSpawned", function()
    print("Entity has spawned")
    
    task.wait(0.1)

    local entityModel = entity.Model 
        or workspace:FindFirstChild("A-60") 
        or workspace:FindFirstChild("A-60 Remake") 
        or workspace:FindFirstChild("A60")

    if not entityModel then
        for _, child in ipairs(workspace:GetChildren()) do
            if child:IsA("Model") and string.find(child.Name, "60") then
                entityModel = child
                break
            end
        end
    end
    
    if entityModel then
        print("Found Entity Model: " .. entityModel.Name)
        
        -- === GLOBAL CUSTOM SCREAM ENGINE ===
        task.spawn(function()
            local customScream = Instance.new("Sound")
            customScream.Name = "A60_CustomScream_Global"
            customScream.SoundId = "rbxassetid://112497140615036"
            customScream.Volume = 5
            customScream.Looped = false
            customScream.Parent = game:GetService("SoundService")
            
            game:GetService("ContentProvider"):PreloadAsync({customScream})
            customScream:Play()
            print("Playing new global scream track!")
            
            customScream.Ended:Connect(function()
                customScream:Destroy()
            end)
        end)
        
        -- === PARTICLE ENGINE LAYER ===
        task.spawn(function()
            local textures = {
                "rbxassetid://124887042598105",
                "rbxassetid://17206102313",
                "rbxassetid://70579374116007",
                "rbxassetid://138308786963210",
                "rbxassetid://107134253330756",
                "rbxassetid://138806755053926",
                "rbxassetid://83021870514358",
                "rbxassetid://133426336717195",
                "rbxassetid://129072942715997",
                "rbxassetid://81268093333511"
            }
            
            local faceEmitter = nil
            
            while entityModel and entityModel.Parent do
                if not faceEmitter then
                    local mainPart = entityModel:FindFirstChild("Main", true)
                    local facePart = mainPart and mainPart:FindFirstChild("Face")
                    
                    if facePart then
                        faceEmitter = facePart:FindFirstChildWhichIsA("ParticleEmitter")
                    end
                    
                    if not faceEmitter then
                        for _, desc in ipairs(entityModel:GetDescendants()) do
                            if desc:IsA("ParticleEmitter") then
                                if desc.Name == "Face" or desc.Parent.Name == "Face" then
                                    faceEmitter = desc
                                    break
                                end
                            end
                        end
                    end
                end
                
                if faceEmitter and faceEmitter.Parent then
                    faceEmitter.Texture = textures[math.random(1, #textures)]
                end
                
                task.wait(0.05)
            end
        end)
    else
        warn("Could not find the A-60 model in Workspace.")
    end

    local function forceRedTint(targetColor, duration)
        local rooms = game.Workspace:FindFirstChild("CurrentRooms")
        if not rooms then return end
        
        local originalColors = {}
        local lights = {}
        
        for _, room in pairs(rooms:GetChildren()) do
            for _, v in pairs(room:GetDescendants()) do
                if v:IsA("Light") then
                    table.insert(lights, v)
                    originalColors[v] = v.Color
                    v.Color = targetColor
                end
            end
        end
        
        task.spawn(function()
            local start = tick()
            while tick() - start < duration do
                local elapsed = tick() - start
                local progress = elapsed / duration
                
                for _, light in ipairs(lights) do
                    if light and light.Parent then
                        local orig = originalColors[light] or Color3.fromRGB(255, 255, 255)
                        light.Color = targetColor:Lerp(orig, progress)
                    end
                end
                task.wait()
            end
            
            for _, light in ipairs(lights) do
                if light and light.Parent then
                    light.Color = originalColors[light]
                end
            end
        end)
    end

    local function smoothEarthquake(duration, maxIntensity)
        local camera = game.Workspace.CurrentCamera
        local start = tick()
        local connection
        
        connection = game:GetService("RunService").RenderStepped:Connect(function()
            local elapsed = tick() - start
            if elapsed >= duration then
                connection:Disconnect()
                return
            end
            
            local currentIntensity = maxIntensity * (1 - (elapsed / duration))
            
            camera.CFrame = camera.CFrame * CFrame.Angles(
                math.rad(math.random(-currentIntensity, currentIntensity) / 10),
                math.rad(math.random(-currentIntensity, currentIntensity) / 10),
                math.rad(math.random(-currentIntensity, currentIntensity) / 10)
            )
        end)
    end

    forceRedTint(Color3.fromRGB(255, 0, 0), 3.5)
    smoothEarthquake(3, 4)
end)

