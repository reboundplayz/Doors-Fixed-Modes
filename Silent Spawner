---====== Manual Proximity Kill System ======---

local isKilling = false 
local DETECTION_RANGE = 50 -- INCREASED: He will now trigger the jumpscare from farther away

local function startJumpscare(targetEntity)
    if isKilling then return end
    isKilling = true

    local player = game.Players.LocalPlayer
    local char = player.Character
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    local cam = game.Workspace.CurrentCamera

    -- 1. FREEZE PLAYER
    if root then root.Anchored = true end

    -- 2. FREEZE ENTITY (Exactly where he is floating)
    local freezePos = targetEntity:GetPivot()
    local freezeConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if targetEntity and targetEntity.Parent then
            targetEntity:PivotTo(freezePos)
        end
    end)

    -- 3. LOCK CAMERA
    cam.CameraType = Enum.CameraType.Scriptable
    local camConnection = game:GetService("RunService").RenderStepped:Connect(function()
        if targetEntity then
            local p = targetEntity:FindFirstChild("HumanoidRootPart") or targetEntity:FindFirstChildWhichIsA("BasePart")
            if p then
                -- Camera looks slightly up if he is floating high
                cam.CFrame = CFrame.new(cam.CFrame.Position, p.Position)
            end
        end
    end)

    -- 4. JUMPSCARE SOUND
    local s = Instance.new("Sound", game:GetService("SoundService"))
    s.SoundId = "rbxassetid://7017782324"
    s.PlaybackSpeed = 2
    s.Volume = 5
    s:Play()

    -- 5. THE 4 SECOND WAIT
    task.wait(4)

    -- 6. CLEANUP AND FINAL DEATH
    freezeConnection:Disconnect()
    camConnection:Disconnect()
    s:Destroy()
    
    if targetEntity then targetEntity:Destroy() end

    hum.Health = 0
    char:BreakJoints()
    
    if root then root.Anchored = false end
    cam.CameraType = Enum.CameraType.Custom
end

---====== Detection Loop ======---

task.spawn(function()
    while true do
        task.wait(0.1)
        if not isKilling then
            local char = game.Players.LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local target = game.Workspace:FindFirstChild("Silent") or game.Workspace:FindFirstChild("Entity")
            
            if root and target then
                local entityPart = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChildWhichIsA("BasePart")
                if entityPart then
                    -- Detection range check
                    local distance = (root.Position - entityPart.Position).Magnitude
                    if distance <= DETECTION_RANGE then
                        startJumpscare(target)
                    end
                end
            end
        end
    end
end)

---====== Triggers ======---

entity:SetCallback("OnSpawned", function()
    task.spawn(playSpawnSound)
    makeCurrentRoomBlue()
end)

entity:SetCallback("OnEnterRoom", function()
    makeCurrentRoomBlue()
end)

---====== Run Entity ======---

entity:Run(true)
