--// Hungry Entity (FINAL UPDATED VERSION)

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local root = character:WaitForChild("HumanoidRootPart")
local camera = workspace.CurrentCamera

--// SETTINGS
local DAMAGE = 30
local ATTACK_DELAY = 2.5
local LOOK_THRESHOLD = 0.65

--// only once per executor/session
getgenv().HungryBadgeGiven = getgenv().HungryBadgeGiven or false

--// LOAD MODEL
local fileName = "shockerasdasdasd.rbxm"

if not isfile(fileName) then
	writefile(
		fileName,
		game:HttpGet("https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/shockersdasda.rbxm")
	)
end

local entity = game:GetObjects(getcustomasset(fileName))[1]
entity.Parent = workspace

if not entity.PrimaryPart then
	entity.PrimaryPart = entity:FindFirstChildWhichIsA("BasePart", true)
end

local primary = entity.PrimaryPart

if not primary then
	warn("No PrimaryPart found for Hungry entity.")
	return
end

--// freeze parts
for _, v in pairs(entity:GetDescendants()) do
	if v:IsA("BasePart") then
		v.Anchored = true
		v.CanCollide = false
	end
end

--// Make OOGA BOOGAAAA collidable
local ooga = entity:FindFirstChild("OOGA BOOGAAAA", true)

if ooga and ooga:IsA("BasePart") then
	ooga.CanCollide = true
	ooga.Anchored = true
	ooga.Massless = false
end

--// spawn in front
entity:PivotTo(root.CFrame * CFrame.new(0, 0, -8))

--// scream
local scream = Instance.new("Sound")
scream.SoundId = "rbxassetid://297569488"
scream.Volume = 3
scream.PlaybackSpeed = 1.1
scream.Parent = primary

local state = "alive"

--// LOOK CHECK
local function IsLookingAtEntity()
	if not entity or not entity.Parent then
		return false
	end

	local camPos = camera.CFrame.Position
	local lookDir = camera.CFrame.LookVector

	for _, part in ipairs(entity:GetDescendants()) do
		if part:IsA("BasePart") then
			local dir = part.Position - camPos
			local dist = dir.Magnitude

			if dist > 0 then
				dir = dir.Unit

				if lookDir:Dot(dir) > LOOK_THRESHOLD then
					local params = RaycastParams.new()
					params.FilterType = Enum.RaycastFilterType.Blacklist
					params.FilterDescendantsInstances = {character}

					local result = workspace:Raycast(camPos, dir * dist, params)

					if result and result.Instance and result.Instance:IsDescendantOf(entity) then
						return true
					end
				end
			end
		end
	end

	return false
end

--// ACHIEVEMENT


--// DESPAWN
local function DespawnEntity(giveBadge)
	if state == "dead" then
		return
	end

	state = "dead"

	for _, v in pairs(entity:GetDescendants()) do
		if v:IsA("BasePart") then
			v.Anchored = false
			v.CanCollide = false
		end
	end

	local badgeDone = false
	local parentConn

	--// badge fires EXACTLY when entity leaves workspace
	if giveBadge then
		parentConn = entity.AncestryChanged:Connect(function(_, parent)
			if parent == nil and not badgeDone then
				badgeDone = true

				if parentConn then
					parentConn:Disconnect()
				end

				GiveShockerBadge()
			end
		end)
	end

	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	bv.Velocity = Vector3.new(0, -160, 0)
	bv.Parent = primary

	task.wait(2)

	if entity and entity.Parent then
		entity:Destroy()
	end

	--// fallback safety
	if giveBadge and entity.Parent == nil and not badgeDone then
		badgeDone = true

		if parentConn then
			parentConn:Disconnect()
		end

		GiveShockerBadge()
	end
end

--// ATTACK
local function Attack()
	if state ~= "alive" then
		return
	end

	state = "attacking"

	local tween = TweenService:Create(
		primary,
		TweenInfo.new(0.2, Enum.EasingStyle.Linear),
		{
			CFrame = root.CFrame
		}
	)

	tween:Play()
	tween.Completed:Wait()

	humanoid:TakeDamage(DAMAGE)
	scream:Play()

	--// CAMERA SHAKE
	local original = camera.CFrame
	local duration = 0.8
	local start = tick()

	while true do
		local t = tick() - start
		local alpha = t / duration

		if alpha >= 1 then
			break
		end

		local drop =
			(-6 * math.exp(-t * 6)) +
			(2.5 * math.exp(-t * 10) * math.sin(t * 25))

		local rebound =
			2 * math.exp(-t * 4) * math.sin(t * 12)

		local y = drop + rebound

		camera.CFrame =
			original *
			CFrame.new(0, y, 0)

		RunService.RenderStepped:Wait()
	end

	camera.CFrame = original

	--// CHANGED: Now passes true so you get the badge when attacked
	DespawnEntity(true)
end

--// LOOK-AWAY DESPAWN
task.spawn(function()
	while state == "alive" and entity and entity.Parent do
		if not IsLookingAtEntity() then
			DespawnEntity(true)
			break
		end

		RunService.RenderStepped:Wait()
	end
end)

--// ATTACK CHECK
task.delay(ATTACK_DELAY, function()
	if state ~= "alive" then
		return
	end

	if IsLookingAtEntity() then
		Attack()
	else
		DespawnEntity(true)
	end
end)
