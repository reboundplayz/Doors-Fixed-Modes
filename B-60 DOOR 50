    end
end

-- ====== Movement Core ======

function EntityMoveTo(targetCFrame)
    if not entity or not entity.Parent then return end
    local reached = false
    local connection
    
    connection = RunService.Stepped:Connect(function(_, step)
        if not entity or not entity.Parent then 
            if connection then connection:Disconnect() end
            reached = true 
            return 
        end
        
        local pivot = entity:GetPivot()
        local difference = (targetCFrame.Position - pivot.Position)
        
        if difference.Magnitude > 0.5 then
            local unit = difference.Unit
            entity:PivotTo(pivot + unit * math.min(step * entityspeed, difference.Magnitude))
        else
            connection:Disconnect()
            reached = true
        end
    end)
    
    local start = tick()
    repeat RunService.Stepped:Wait() until reached or (tick() - start > 15)
    if connection then connection:Disconnect() end
end

-- ====== Helper Room Functions ======

local function getRoomEntranceCFrame()
    local room50 = workspace.CurrentRooms:FindFirstChild("50")
    if room50 and room50:FindFirstChild("RoomEntrance") then
        return room50.RoomEntrance.CFrame + Vector3.new(0, 5, 0)
    end
    return CFrame.new(841.8, 10, -468.3) -- Fallback
end

-- Spawn initially at RoomEntrance
entity:PivotTo(getRoomEntranceCFrame())

-- ====== Kill Logic (Active Raycast & Collision Check) ======

task.spawn(function()
    while RunService.Heartbeat:Wait() and entity and entity.Parent do
        if not isKilling then
            local character = LocalPlayer.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            
            local isHiding = LocalPlayer:GetAttribute("Hiding") == true 
                or (character and character:GetAttribute("Hiding") == true)
                or (character and character:FindFirstChild("Hidden"))
            
            if root and not isHiding then
                local entityPart = entity.PrimaryPart or entity:FindFirstChildWhichIsA("BasePart")
                if entityPart then
                    local distance = (entityPart.Position - root.Position).Magnitude
                    
                    if distance < killRange then
                        local rayParams = RaycastParams.new()
                        rayParams.FilterDescendantsInstances = {character, entity}
                        rayParams.FilterType = Enum.RaycastFilterType.Exclude
                        
                        local direction = (root.Position - entityPart.Position)
                        local rayResult = workspace:Raycast(entityPart.Position, direction, rayParams)
                        
                        if not rayResult then
                            runHardJumpscare()
                        end
                    end
                end
            end
        end
    end
end)

-- ====== Pathing & Loops Logic ======

local function runPatrolSequence()
    local pathFolder = workspace:FindFirstChild("FigureNodes", true)
    if not pathFolder then 
        task.wait(1)
        return false
    end
    
    local nodes = pathFolder:GetChildren()
    
    table.sort(nodes, function(a, b)
        local numA = tonumber(a.Name:match("%d+")) or 0
        local numB = tonumber(b.Name:match("%d+")) or 0
        return numA < numB
    end)

    -- Loop Part 1: Through all 22 nodes
    for _, node in ipairs(nodes) do
        if not entity or not entity.Parent then return false end
        if node:IsA("BasePart") then
            EntityMoveTo(node.CFrame + Vector3.new(0, 4, 0))
        end
    end
    
    -- Loop Part 2: Return back to RoomEntrance
    if not entity or not entity.Parent then return false end
    EntityMoveTo(getRoomEntranceCFrame())
    
    return true
end

-- ====== Main Execution Loop (3 Complete Cycles) ======

task.spawn(function()
    local completedLoops = 0
    
    while entity and entity.Parent and completedLoops < 3 do
        local success = runPatrolSequence()
        if success then
            completedLoops = completedLoops + 1
            print("B-60 finished sequence path loop: " .. tostring(completedLoops) .. "/3")
        end
        task.wait(0.1)
    end
    
    -- Triggers when natural path loops finish successfully
    if entity and entity.Parent then
        entity:Destroy()
        -- The big red shake from your old script (Intensity 55, 8 Seconds duration)
        forceRedTint(Color3.fromRGB(150, 0, 0), 8) 
        smoothEarthquake(8, 55)
    end
end)

