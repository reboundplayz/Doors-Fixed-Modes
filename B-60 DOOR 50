forceRedTint(Color3.fromRGB(255, 0, 0), 4.5)
smoothEarthquake(4.5, 15)

task.spawn(function()
    entity = LoadEntity()
    if not entity then return end

    -- Targeted ParticleEmitter Loop
    task.spawn(function()
        local head = entity:WaitForChild("Head", 10)
        local emitter = head and head:WaitForChild("ParticleEmitter", 5)
        
        if emitter then
            while entity and entity.Parent do
                emitter.Texture = "rbxassetid://132608289829623"
                task.wait(0.05)
                emitter.Texture = "rbxassetid://132598758780611"
                task.wait(0.05)
                emitter.Texture = "rbxassetid://103365774502046"
                task.wait(0.05)
                emitter.Texture = "rbxassetid://120065678981246"
                task.wait(0.05)
                emitter.Texture = "rbxassetid://14303506455"
                task.wait(0.05)
            end
        end
    end)

    -- Make completely invisible initially
    for _, v in ipairs(entity:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Transparency = 1
            v.Anchored = true
            v.CanCollide = false
        end
    end

    local spawnCF = getRoomEntranceCFrame()
    entity:PivotTo(spawnCF * CFrame.new(0, 0, 30))

    local soundPart = entity.PrimaryPart or entity:FindFirstChildWhichIsA("BasePart")
    if soundPart then
        local spawnSound = Instance.new("Sound", soundPart)
        spawnSound.Name = "B60SpawnSound"
        spawnSound.SoundId = SpawnSoundID
        spawnSound.Volume = 3
        spawnSound.RollOffMaxDistance = 150
        spawnSound.RollOffMinDistance = 10
        
        if not spawnSound.IsLoaded then spawnSound.Loaded:Wait() end
        spawnSound:Play()
        
        spawnSound.Ended:Connect(function()
            spawnSound:Destroy()
        end)
    end

    task.wait(5)

    -- Return visibility to parts when it attacks
    for _, v in ipairs(entity:GetDescendants()) do
        if v:IsA("BasePart") then
            if v.Name == "Head" or v.Name == "HumanoidRootPart" then
                v.Transparency = 1
            else
                v.Transparency = 0
            end
        end
    end
    entity:PivotTo(spawnCF)

    -- Kill Detection Loop
    task.spawn(function()
        while RunService.Heartbeat:Wait() and entity and entity.Parent do
            if not isKilling then
                local character = LocalPlayer.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                
                local isHiding = LocalPlayer:GetAttribute("Hiding") == true 
                    or (character and character:GetAttribute("Hiding") == true)
                    or (character and character:FindFirstChild("Hidden"))
                
                if root and not isHiding then
                    local entityPart = entity.PrimaryPart or entity:FindFirstChildWhichIsA("BasePart")
                    if entityPart then
                        local distance = (entityPart.Position - root.Position).Magnitude
                        
                        if distance < killRange then
                            local rayParams = RaycastParams.new()
                            rayParams.FilterDescendantsInstances = {character, entity}
                            rayParams.FilterType = Enum.RaycastFilterType.Exclude
                            
                            local direction = (root.Position - entityPart.Position)
                            local rayResult = workspace:Raycast(entityPart.Position, direction, rayParams)
                            
                            if not rayResult then
                                runHardJumpscare()
                            end
                        end
                    end
                end
            end
        end
    end)

    local completedLoops = 0
    while entity and entity.Parent and completedLoops < 3 do
        local success = runPatrolSequence()
        if success then
            completedLoops = completedLoops + 1
            print("B-60 finished sequence path loop: " .. tostring(completedLoops) .. "/3")
        end
        task.wait(0.1)
    end
    
    -- Finale: Natural Loop Completion Outro
    if entity and entity.Parent then
        entity:Destroy()
        AwardB60Achievement()
        forceRedTint(Color3.fromRGB(150, 0, 0), 8) 
        smoothEarthquake(8, 55)
    end
end)

