-- ====== Logic Functions ======

local function AwardB60Achievement()
    if not getgenv().B60AchievementExecuted then
        getgenv().B60AchievementExecuted = true

        loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"))()({
            Title = "Born From Static",
            Desc = "Its smile never changes..",
            Reason = "Encounter B-60",
            Image = "rbxassetid://117667968899219",
        })
    end
end

local function forceRedTint(targetColor, duration)
    local rooms = game.Workspace:FindFirstChild("CurrentRooms")
    if not rooms then return end
    
    local originalColors = {}
    local lights = {}
    
    for _, room in pairs(rooms:GetChildren()) do
        for _, v in pairs(room:GetDescendants()) do
            if v:IsA("Light") then
                table.insert(lights, v)
                originalColors[v] = v.Color
                v.Color = targetColor
            end
        end
    end
    
    task.spawn(function()
        local start = tick()
        while tick() - start < duration do
            local elapsed = tick() - start
            local progress = elapsed / duration
            
            for _, light in ipairs(lights) do
                if light and light.Parent then
                    local orig = originalColors[light] or Color3.fromRGB(255, 255, 255)
                    light.Color = targetColor:Lerp(orig, progress)
                end
            end
            task.wait()
        end
        
        for _, light in ipairs(lights) do
            if light and light.Parent then
                light.Color = originalColors[light]
            end
        end
    end)
end

local function smoothEarthquake(duration, maxIntensity)
    local camera = game.Workspace.CurrentCamera
    local start = tick()
    local connection
    
    connection = RunService.RenderStepped:Connect(function()
        local elapsed = tick() - start
        if elapsed >= duration then
            connection:Disconnect()
            return
        end
        
        local currentIntensity = maxIntensity * (1 - (elapsed / duration))
        
        camera.CFrame = camera.CFrame * CFrame.Angles(
            math.rad(math.random(-currentIntensity, currentIntensity) / 10),
            math.rad(math.random(-currentIntensity, currentIntensity) / 10),
            math.rad(math.random(-currentIntensity, currentIntensity) / 10)
        )
    end)
end

-- ====== Hardcore Jumpscare Logic ======

local isKilling = false
local function runHardJumpscare()
    if isKilling then return end
    isKilling = true
    
    local char = LocalPlayer.Character
    local gui = Instance.new("ScreenGui", LocalPlayer.PlayerGui)
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 1000

    local s = Instance.new("Sound", game:GetService("SoundService"))
    s.SoundId = KillSoundID
    s.Volume = 3 
    s:Play()

    for i = 1, 14 do
        local img = Instance.new("ImageLabel", gui)
        img.BackgroundTransparency = 1
        img.Image = FaceIDs[math.random(1, #FaceIDs)]
        img.ImageColor3 = Color3.fromRGB(255, 0, 0)
        img.Size = UDim2.new(0.8, 0, 0.8, 0)
        img.AnchorPoint = Vector2.new(0.5, 0.5)
        img.Position = UDim2.new(0.5 + math.random(-15, 15)/100, 0, 0.5 + math.random(-15, 15)/100, 0)
        img.Rotation = math.random(-45, 45)
        task.wait(0.05)
        img:Destroy()
    end

    local finalFace = Instance.new("ImageLabel", gui)
    finalFace.Image = "rbxassetid://103365774502046" 
    finalFace.ImageColor3 = Color3.fromRGB(200, 0, 0) 
    finalFace.BackgroundTransparency = 1
    finalFace.AnchorPoint = Vector2.new(0.5, 0.5)
    finalFace.Position = UDim2.new(0.5, 0, 0.5, 0)
    
    local zoomStart = tick()
    while tick() - zoomStart < 1.3 do
        local size = 0.5 + ((tick() - zoomStart) * 6.5) 
        finalFace.Size = UDim2.new(size, 0, size, 0)
        finalFace.Position = UDim2.new(0.5, math.random(-80, 80), 0.5, math.random(-80, 80))
        task.wait()
    end
    
    if char and char:FindFirstChildOfClass("Humanoid") then 
        char:FindFirstChildOfClass("Humanoid").Health = 0 
    end
    if char then char:BreakJoints() end
    
    task.wait(0.5)
    gui:Destroy()
    isKilling = false
end

-- ====== Setup Model Function ======

local function LoadEntity()
    local success, objects = pcall(function()
        return game:GetObjects(assetId)
    end)
    if success and objects and objects[1] then
        local model = objects[1]
        model.Name = entityName
        model.Parent = workspace
        return model
    end
    return nil
end

-- ====== Helper Room Functions ======

local function getRoomEntranceCFrame()
    local room50 = workspace.CurrentRooms:FindFirstChild("50")
    if room50 and room50:FindFirstChild("RoomEntrance") then
        return room50.RoomEntrance.CFrame + Vector3.new(0, 5, 0)
    end
    return CFrame.new(841.8, 10, -468.3) -- Fallback
end

-- ====== Movement Core ======

local entity = nil

function EntityMoveTo(targetCFrame)
    if not entity or not entity.Parent then return end
    local reached = false
    local connection
    
    connection = RunService.Stepped:Connect(function(_, step)
        if not entity or not entity.Parent then 
            if connection then connection:Disconnect() end
            reached = true 
            return 
        end
        
        local pivot = entity:GetPivot()
        local difference = (targetCFrame.Position - pivot.Position)
        
        if difference.Magnitude > 0.5 then
            local unit = difference.Unit
            entity:PivotTo(pivot + unit * math.min(step * entityspeed, difference.Magnitude))
        else
            connection:Disconnect()
            reached = true
        end
    end)
    
    local start = tick()
    repeat RunService.Stepped:Wait() until reached or (tick() - start > 15)
    if connection then connection:Disconnect() end
end

-- ====== Pathing & Loops Logic ======

local function runPatrolSequence()
    local pathFolder = workspace:FindFirstChild("FigureNodes", true)
    if not pathFolder then 
        task.wait(1)
        return false
    end
    
    local nodes = pathFolder:GetChildren()
    
    table.sort(nodes, function(a, b)
        local numA = tonumber(a.Name:match("%d+")) or 0
        local numB = tonumber(b.Name:match("%d+")) or 0
        return numA < numB
    end)

    for _, node in ipairs(nodes) do
        if not entity or not entity.Parent then return false end
        if node:IsA("BasePart") then
            EntityMoveTo(node.CFrame + Vector3.new(0, 4, 0))
        end
    end
    
    if not entity or not entity.Parent then return false end
    EntityMoveTo(getRoomEntranceCFrame())
    
    return true
end

