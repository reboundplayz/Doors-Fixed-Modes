-- ====== Logic Functions (Visuals & Screenshake) ======

local function forceRedTint(color, duration)
    local rooms = game.Workspace:FindFirstChild("CurrentRooms")
    if not rooms then return end
    for _, room in pairs(rooms:GetChildren()) do
        for _, v in pairs(room:GetDescendants()) do
            if v:IsA("Light") then
                local oldCol = v.Color
                v.Color = color
                task.delay(duration, function() v.Color = oldCol end)
            end
        end
    end
end

local function smoothEarthquake(duration, maxIntensity)
    local camera = game.Workspace.CurrentCamera
    local start = tick()
    local connection
    
    connection = RunService.RenderStepped:Connect(function()
        local elapsed = tick() - start
        if elapsed >= duration then
            connection:Disconnect()
            return
        end
        
        local currentIntensity = maxIntensity * (1 - (elapsed / duration))
        
        camera.CFrame = camera.CFrame * CFrame.Angles(
            math.rad(math.random(-currentIntensity, currentIntensity) / 10),
            math.rad(math.random(-currentIntensity, currentIntensity) / 10),
            math.rad(math.random(-currentIntensity, currentIntensity) / 10)
        )
    end)
end

-- ====== Hardcore Jumpscare Logic ======

local isKilling = false
local function runHardJumpscare()
    if isKilling then return end
    isKilling = true
    
    local char = LocalPlayer.Character
    local gui = Instance.new("ScreenGui", LocalPlayer.PlayerGui)
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 1000

    local s = Instance.new("Sound", game:GetService("SoundService"))
    s.SoundId = KillSoundID
    s.Volume = 3 
    s:Play()

    for i = 1, 14 do
        local img = Instance.new("ImageLabel", gui)
        img.BackgroundTransparency = 1
        img.Image = FaceIDs[math.random(1, #FaceIDs)]
        img.ImageColor3 = Color3.fromRGB(255, 0, 0)
        img.Size = UDim2.new(0.8, 0, 0.8, 0)
        img.AnchorPoint = Vector2.new(0.5, 0.5)
        img.Position = UDim2.new(0.5 + math.random(-15, 15)/100, 0, 0.5 + math.random(-15, 15)/100, 0)
        img.Rotation = math.random(-45, 45)
        task.wait(0.05)
        img:Destroy()
    end

    local finalFace = Instance.new("ImageLabel", gui)
    finalFace.Image = "rbxassetid://103365774502046" 
    finalFace.ImageColor3 = Color3.fromRGB(200, 0, 0) 
    finalFace.BackgroundTransparency = 1
    finalFace.AnchorPoint = Vector2.new(0.5, 0.5)
    finalFace.Position = UDim2.new(0.5, 0, 0.5, 0)
    
    local zoomStart = tick()
    while tick() - zoomStart < 1.3 do
        local size = 0.5 + ((tick() - zoomStart) * 6.5) 
        finalFace.Size = UDim2.new(size, 0, size, 0)
        finalFace.Position = UDim2.new(0.5, math.random(-80, 80), 0.5, math.random(-80, 80))
        task.wait()
    end
    
    if char and char:FindFirstChildOfClass("Humanoid") then 
        char:FindFirstChildOfClass("Humanoid").Health = 0 
    end
    if char then char:BreakJoints() end
    
    task.wait(0.5)
    gui:Destroy()
    isKilling = false
end

-- ====== Setup Model ======

local function LoadEntity()
    local success, objects = pcall(function()
        return game:GetObjects(assetId)
    end)
    if success and objects and objects[1] then
        local model = objects[1]
        model.Name = entityName
        model.Parent = workspace
        return model
    end
    return nil
end

