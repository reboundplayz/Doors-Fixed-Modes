local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Asset Configuration
local ASSETS = {
    A278         = "rbxassetid://12731800555",
    ULB278       = "rbxassetid://82318075149007",
    TLAB         = "rbxassetid://12731861571",
    JumpscareImg = "rbxassetid://11945909450",
    
    -- Dynamic Variant Portal Mappings
    A278_Portal  = "rbxassetid://111163328859735",
    TLAB_Portal  = "rbxassetid://122019150116718",
    ULB_Portal   = "rbxassetid://82868855643582"
}

local JUMP_SOUND_URL = "https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/A-278Jumpscare.mp3.mpeg"
local SPEED = 32 
local ATTACK_DURATION = 30 

-- Helper to download real 3D assets on the fly with variant-specific color fallbacks
local function loadRealRobloxModel(assetId, name, variantType)
    local success, objects = pcall(function()
        return game:GetObjects(assetId)
    end)
    
    local loadedModel
    if success and objects and #objects > 0 then
        loadedModel = objects[1]
        if not loadedModel:IsA("Model") then
            local container = Instance.new("Model")
            loadedModel.Parent = container
            loadedModel = container
        end
    else
        loadedModel = Instance.new("Model")
        local p = Instance.new("Part", loadedModel)
        p.Name = "HumanoidRootPart"
        p.Size = Vector3.new(5, 5, 5)
        p.Material = Enum.Material.Neon
        
        -- Fallback colors per entity identity
        if variantType == "ULB" then
            p.Color = Color3.fromRGB(200, 0, 0)
        elseif variantType == "TLAB" then
            p.Color = Color3.fromRGB(0, 150, 255)
        else
            p.Color = Color3.fromRGB(140, 0, 180) -- Base A-278 Purple
        end
    end
    
    loadedModel.Name = name
    if not loadedModel.PrimaryPart then
        local root = loadedModel:FindFirstChildWhichIsA("BasePart", true)
        if root then loadedModel.PrimaryPart = root else
            local rootPart = Instance.new("Part", loadedModel)
            rootPart.Name = "HumanoidRootPart"
            rootPart.Size = Vector3.new(1,1,1)
            rootPart.Transparency = 1
            loadedModel.PrimaryPart = rootPart
        end
    end
    
    for _, part in ipairs(loadedModel:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Anchored = true
        end
    end
    
    return loadedModel
end

-----------------------------------------
-- ATMOSPHERIC LIGHT FLICKER
-----------------------------------------
local function flickerLights()
    local roomsFolder = workspace:FindFirstChild("CurrentRooms")
    if not roomsFolder then return end

    local purpleColor = Color3.fromRGB(93, 0, 255)
    local blackColor = Color3.fromRGB(0, 0, 0)

    task.spawn(function()
        for _, room in ipairs(roomsFolder:GetChildren()) do
            for _, light in ipairs(room:GetDescendants()) do
                if light:IsA("Light") or light:IsA("SurfaceLight") or light:IsA("PointLight") then
                    task.spawn(function()
                        local originalColor = light.Color
                        local originalEnabled = light.Enabled
                        for i = 1, 14 do
                            light.Color = (i % 2 == 0) and purpleColor or blackColor
                            light.Enabled = (i % 3 ~= 0)
                            task.wait(0.06)
                        end
                        light.Color = originalColor
                        light.Enabled = originalEnabled
                    end)
                end
            end
        end
    end)
end

