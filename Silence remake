-- Silence Entity Behavior (Final Optimized Polish Build)

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")

local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local HRP = Character:WaitForChild("HumanoidRootPart")

-- SPEED CONTROLLER BASES
local DEFAULT_WALKSPEED = 16
local RESTRAINED_CROUCH_SPEED = 6
local RESTRAINED_LOOK_SPEED = 10.5

-- FILE HANDLING
local assetFileName = "bruhsilence.rbxm"
local assetUrl = "https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/bruhsilence.rbxm"

if not isfile(assetFileName) then
    print("[Silence] Downloading asset model...")
    local success, modelData = pcall(function() return game:HttpGet(assetUrl) end)
    if success then writefile(assetFileName, modelData) else return end
end

local assetId = getcustomasset(assetFileName)
local success, objects = pcall(function() return game:GetObjects(assetId) end)
if not success or not objects or #objects == 0 then return end

local SilenceModel = objects[1]
if SilenceModel:IsA("Model") and #SilenceModel:GetChildren() == 1 and SilenceModel:GetChildren()[1]:IsA("Model") then
    SilenceModel = SilenceModel:GetChildren()[1]
end

local mainPart = SilenceModel:FindFirstChild("RushNew") or SilenceModel:FindFirstChildWhichIsA("BasePart")
SilenceModel.PrimaryPart = mainPart

for _, desc in ipairs(SilenceModel:GetDescendants()) do
    if desc:IsA("BasePart") then
        desc.CanCollide = false
        desc.Anchored = (desc == SilenceModel.PrimaryPart)
        
        if desc ~= SilenceModel.PrimaryPart then
            local weld = desc:FindFirstChild("SilenceWeld") or Instance.new("WeldConstraint")
            weld.Name = "SilenceWeld"
            weld.Part0 = desc
            weld.Part1 = SilenceModel.PrimaryPart
            weld.Parent = desc
            desc.Anchored = false
        end
        
        if desc.Name == "RushNew" or desc:FindFirstChildWhichIsA("SpecialMesh") or desc:IsA("MeshPart") then
            desc.Color = Color3.fromRGB(0, 0, 0)
        end
    elseif desc:IsA("BodyVelocity") or desc:IsA("BodyGyro") then
        desc:Destroy()
    elseif desc:IsA("ParticleEmitter") or desc:IsA("Beam") then
        desc.Enabled = true
    end
end

SilenceModel.Parent = workspace

----------------------------------------------------
-- DEPLOYMENT & ROOM STATIC OVERLAY PREPARATION
----------------------------------------------------
local roomsContainer = workspace:WaitForChild("CurrentRooms")
local rooms = roomsContainer:GetChildren()
local currentRoom = rooms[#rooms - 1] -- Targets the room Silence occupies (LatestRoom - 1)
local targetFloorCFrame

if currentRoom and currentRoom:FindFirstChild("Parts") and currentRoom.Parts:FindFirstChild("Floor") then
    targetFloorCFrame = currentRoom.Parts.Floor.CFrame + Vector3.new(0, 4.5, 0)
else
    targetFloorCFrame = HRP.CFrame * CFrame.new(0, 1.5, -35)
end

local skySpawnCFrame = targetFloorCFrame + Vector3.new(0, 70, 0)
SilenceModel:SetPrimaryPartCFrame(skySpawnCFrame)

local repentSound = SilenceModel:FindFirstChild("Repent", true)
if repentSound and repentSound:IsA("Sound") then
    repentSound.Volume = 2
    repentSound:Play()
end

-- Sharp Purple Lighting Flashes
task.spawn(function()
    local origAmbient = Lighting.Ambient
    local origColorShift = Lighting.ColorShift_Top
    for i = 1, 3 do
        Lighting.Ambient = Color3.fromRGB(80, 0, 140)
        Lighting.ColorShift_Top = Color3.fromRGB(138, 43, 226)
        task.wait(0.06)
        Lighting.Ambient = origAmbient
        Lighting.ColorShift_Top = origColorShift
        task.wait(0.08)
    end
end)

-- Drop down smoothly
local dropTween = TweenService:Create(SilenceModel.PrimaryPart, TweenInfo.new(2, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
    CFrame = targetFloorCFrame
})
dropTween:Play()

-- DYNAMIC ROOM STATIC DISTORTION LAYER CREATION
local roomTextures = {}
local faces = {Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Left, Enum.NormalId.Right, Enum.NormalId.Front, Enum.NormalId.Back}
local texturesActive = true

if currentRoom then
    for _, part in ipairs(currentRoom:GetDescendants()) do
        if part:IsA("BasePart") and part.Transparency < 1 then
            for _, face in ipairs(faces) do
                local tex = Instance.new("Texture")
                tex.Texture = "rbxassetid://17563070976"
                tex.Face = face
                tex.StudsPerTileU = 4
                tex.StudsPerTileV = 4
                tex.Transparency = 1 
                tex.Parent = part
                table.insert(roomTextures, tex)
                
                -- Fade in room texturing
                TweenService:Create(tex, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 0.4}):Play()
            end
        end
    end
end

-- PERFORMANCE FIX: Throttled thread to step texture coordinates less aggressively to resolve lag
task.spawn(function()
    while texturesActive do
        local rngU = math.random() * 10
        local rngV = math.random() * 10
        for _, tex in ipairs(roomTextures) do
            if tex and tex.Parent then
                tex.OffsetStudsU = rngU
                tex.OffsetStudsV = rngV
            end
        end
        task.wait(0.08) -- Updates around ~12 times a second instead of 60+, removing performance strain
    end
end)

----------------------------------------------------
-- GUI DESIGN & INTERFACES
----------------------------------------------------
local PlayerGui = Player:WaitForChild("PlayerGui")
if PlayerGui:FindFirstChild("NoiseMeterGui") then PlayerGui.NoiseMeterGui:Destroy() end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "NoiseMeterGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local Vignette = Instance.new("ImageLabel")
Vignette.Name = "Vignette"
Vignette.Size = UDim2.new(1, 0, 1, 0)
Vignette.BackgroundTransparency = 1
Vignette.Image = "rbxassetid://4576475446"
Vignette.ImageColor3 = Color3.fromRGB(35, 0, 60)
Vignette.ImageTransparency = 1
Vignette.Parent = ScreenGui

local ShadowWrapper = Instance.new("Frame")
ShadowWrapper.Name = "ShadowWrapper"
ShadowWrapper.Size = UDim2.new(0, 20, 0, 326)
ShadowWrapper.Position = UDim2.new(0.04, -3, 0.5, -163)
ShadowWrapper.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
ShadowWrapper.BackgroundTransparency = 0.65
ShadowWrapper.BorderSizePixel = 0
ShadowWrapper.Parent = ScreenGui

local ShadowCorner = Instance.new("UICorner")
ShadowCorner.CornerRadius = UDim.new(0, 8)
ShadowCorner.Parent = ShadowWrapper

local MeterBackground = Instance.new("Frame")
MeterBackground.Name = "MeterBackground"
MeterBackground.Size = UDim2.new(0, 14, 0, 320)
MeterBackground.Position = UDim2.new(0.5, -7, 0.5, -160)
MeterBackground.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
MeterBackground.BackgroundTransparency = 0.3
MeterBackground.BorderSizePixel = 0
MeterBackground.Parent = ShadowWrapper

local BgCorner = Instance.new("UICorner")
BgCorner.CornerRadius = UDim.new(0, 6)
BgCorner.Parent = MeterBackground

local MeterFill = Instance.new("Frame")
MeterFill.Name = "MeterFill"
MeterFill.Size = UDim2.new(1, 0, 0, 0)
MeterFill.Position = UDim2.new(0, 0, 1, 0)
MeterFill.AnchorPoint = Vector2.new(0, 1)
MeterFill.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
MeterFill.BorderSizePixel = 0
MeterFill.Parent = MeterBackground

local FillCorner = Instance.new("UICorner")
FillCorner.CornerRadius = UDim.new(0, 6)
FillCorner.Parent = MeterFill

local Heartbeat = Instance.new("Sound")
Heartbeat.SoundId = "rbxassetid://136926364647386"
Heartbeat.Volume = 0
Heartbeat.Looped = true
Heartbeat.Parent = HRP
Heartbeat:Play()

local SiphonFilter = Instance.new("EqualizerSoundEffect")
SiphonFilter.Name = "SilenceSiphon"
SiphonFilter.HighGain = 0
SiphonFilter.MidGain = 0
SiphonFilter.LowGain = 0
SiphonFilter.Enabled = false
SiphonFilter.Parent = SoundService

----------------------------------------------------
-- STATE VARIABLES
----------------------------------------------------
local currentNoise = 0
local maxNoise = 100
local isFaceVisible = false
local isAttacking = false
local entityActive = true

task.spawn(function()
    while SilenceModel and SilenceModel.Parent and not isAttacking and entityActive do
        isFaceVisible = false
        task.wait(math.random(3, 5))
        if isAttacking or not entityActive then break end
        isFaceVisible = true
        task.wait(math.random(2, 4))
    end
end)

----------------------------------------------------
-- REPLICATEDSTORAGE ADVANCEMENT & ASCENDING DESPAWN
----------------------------------------------------
task.spawn(function()
    local latestRoomObj = ReplicatedStorage:WaitForChild("GameData"):WaitForChild("LatestRoom")
    latestRoomObj.Changed:Wait()
    
    if entityActive then
        entityActive = false
        isFaceVisible = false
        texturesActive = false
        Humanoid.WalkSpeed = DEFAULT_WALKSPEED
        
        -- Smoothly fade out the room's distortion textures
        for _, tex in ipairs(roomTextures) do
            if tex and tex.Parent then
                TweenService:Create(tex, TweenInfo.new(0.8), {Transparency = 1}):Play()
            end
        end
        
        -- GUI element fade-outs
        TweenService:Create(ShadowWrapper, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
        TweenService:Create(MeterBackground, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
        TweenService:Create(MeterFill, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
        TweenService:Create(Vignette, TweenInfo.new(0.5), {ImageTransparency = 1}):Play()
        TweenService:Create(Heartbeat, TweenInfo.new(0.4), {Volume = 0}):Play()
        
        SiphonFilter.Enabled = false
        SiphonFilter:Destroy()
        
        -- Move back UP into the ceiling smoothly
        local raiseTween = TweenService:Create(SilenceModel.PrimaryPart, TweenInfo.new(1.2, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {
            CFrame = skySpawnCFrame
        })
        raiseTween:Play()
        
        for _, part in ipairs(SilenceModel:GetDescendants()) do
            if part:IsA("BasePart") then
                TweenService:Create(part, TweenInfo.new(1.0), {Transparency = 1}):Play()
            elseif part:IsA("ParticleEmitter") or part:IsA("Beam") then
                part.Enabled = false
            end
        end
        
        task.wait(1.2)
        for _, tex in ipairs(roomTextures) do if tex then tex:Destroy() end end
        Heartbeat:Destroy()
        ScreenGui:Destroy()
        SilenceModel:Destroy()
    end
end)

----------------------------------------------------
-- MAIN RUNSERVICE CORE ENGINE LOOP
----------------------------------------------------
local loopConnection
local basePositionX = 0.04
local frameCounter = 0

loopConnection = RunService.RenderStepped:Connect(function(dt)
    if not SilenceModel or not SilenceModel.Parent or isAttacking or not entityActive then 
        loopConnection:Disconnect()
        return 
    end
    
    frameCounter = frameCounter + 1
    local distance = (HRP.Position - SilenceModel.PrimaryPart.Position).Magnitude
    
    local isMoving = Humanoid.MoveDirection.Magnitude > 0
    local isCrouching = (Character:GetAttribute("Crouching") == true) or (Character:GetAttribute("crouching") == true)
    
    -- ADRENALINE AUDIO / VIGNETTE INTERPOLATION
    if distance < 65 then
        local proximityScale = 1 - (distance / 65)
        local pulseFactor = math.sin(frameCounter * 0.16) * 0.07
        
        Vignette.ImageTransparency = math.clamp(1 - (proximityScale * 0.9) + pulseFactor, 0.05, 1)
        Heartbeat.Volume = proximityScale * 2.2
        
        if isFaceVisible then
            SiphonFilter.Enabled = true
            SiphonFilter.HighGain = math.clamp(-40 * proximityScale, -80, 0)
            SiphonFilter.MidGain = math.clamp(-20 * proximityScale, -40, 0)
        else
            SiphonFilter.HighGain = 0
            SiphonFilter.MidGain = 0
        end
    else
        Vignette.ImageTransparency = 1
        Heartbeat.Volume = 0
        SiphonFilter.Enabled = false
    end
    
    -- SPEED CONTROL REGULATORS
    if isCrouching then
        Humanoid.WalkSpeed = RESTRAINED_CROUCH_SPEED
        ShadowWrapper.Position = UDim2.new(basePositionX, -3, 0.5, -163)
    elseif isFaceVisible then
        local shakeOffset = math.random(-3, 3)
        ShadowWrapper.Position = UDim2.new(basePositionX, shakeOffset, 0.5, -163)
        
        if isMoving then
            Humanoid.WalkSpeed = RESTRAINED_LOOK_SPEED
        end
    else
        ShadowWrapper.Position = UDim2.new(basePositionX, -3, 0.5, -163)
        Humanoid.WalkSpeed = DEFAULT_WALKSPEED
    end
    
    -- NOISE MATHEMATICS ACCUMULATION
    if isMoving then
        if isCrouching then
            currentNoise = math.clamp(currentNoise - (25 * dt), 0, maxNoise)
        elseif isFaceVisible then
            currentNoise = math.clamp(currentNoise + (52 * dt), 0, maxNoise)
        else
            currentNoise = math.clamp(currentNoise + (12 * dt), 0, maxNoise)
        end
    else
        currentNoise = math.clamp(currentNoise - (32 * dt), 0, maxNoise)
    end
    
    MeterFill.Size = UDim2.new(1, 0, currentNoise / maxNoise, 0)
    
    if isFaceVisible and isMoving and not isCrouching then
        MeterFill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    elseif isCrouching then
        MeterFill.BackgroundColor3 = Color3.fromRGB(0, 220, 110)
    else
        MeterFill.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
    end
    
    -- JUMPSCARE ACTION SEQUENCES
    if currentNoise >= maxNoise then
        isAttacking = true
        loopConnection:Disconnect()
        entityActive = false
        texturesActive = false
        Heartbeat:Destroy()
        for _, tex in ipairs(roomTextures) do if tex then tex:Destroy() end end
        
        if SiphonFilter then SiphonFilter:Destroy() end
        Humanoid.WalkSpeed = 0
        Humanoid.JumpPower = 0
        
        local originalScare = SilenceModel:FindFirstChild("Scare", true)
        if originalScare and originalScare:IsA("Sound") then
            local standaloneScare = originalScare:Clone()
            standaloneScare.Looped = false
            standaloneScare.Volume = 9
            standaloneScare.Parent = workspace
            standaloneScare:Play()
            
            task.delay(standaloneScare.TimeLength + 0.5, function()
                standaloneScare:Destroy()
            end)
        end
        
        local attackTween = TweenService:Create(SilenceModel.PrimaryPart, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            CFrame = HRP.CFrame * CFrame.new(0, 0, -1.2)
        })
        
        attackTween:Play()
        attackTween.Completed:Wait()
        
        -- FINAL REQUEST: Set explicit custom string value tracking for game logs / statistics
        pcall(function()
            local gameStats = ReplicatedStorage:FindFirstChild("GameStats")
            if gameStats then
                local playerStats = gameStats:FindFirstChild("Player_" .. Player.Name)
                if playerStats and playerStats:FindFirstChild("Total") and playerStats.Total:FindFirstChild("DeathCause") then
                    playerStats.Total.DeathCause.Value = "Silence"
                end
            end
        end)
        
        Humanoid.Health = 0 
        ScreenGui:Destroy()
        SilenceModel:Destroy()
    end
end)
