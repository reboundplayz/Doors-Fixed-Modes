-- ---====== Helper: Audio File Downloader ======---
local function createCustomSound(fileName, url, parent)
    local sound = Instance.new("Sound")
    pcall(function()
        if not isfile(fileName) then
            writefile(fileName, game:HttpGet(url))
        end
        sound.SoundId = getcustomasset(fileName)
    end)
    sound.Parent = parent
    return sound
end

