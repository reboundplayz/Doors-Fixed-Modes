-- Helper function to download and cache the asset locally with unique names
local function cacheGitSound(GithubSoundPath: string, AssetName: string): string
    local Url = GithubSoundPath
    local fileName = AssetName..".mp3"

    if not isfile(fileName) then 
        writefile(fileName, game:HttpGet(Url)) 
    end

    return getcustomasset(fileName, true)
end

-- Fetch custom audio IDs
local customLibraryId = cacheGitSound("https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/941913_Portal-To-The-Other-Side-f.mp3", "portalSide")
local customDoor100Id = cacheGitSound("https://github.com/kodbolx/kodbolhub/blob/main/Nightmare%20Mode/Sounds/library1.mp3?raw=true", "library1")
local customSeekId = cacheGitSound("https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/SeekMoving.mp3", "SeekMusic")

-- Volume configurations
local FIGURE_VOLUME = 0.5

-- ==========================================
-- AUTOMATION LOGIC
-- ==========================================

task.spawn(function()
    while task.wait(0.3) do -- Fast check loop
        
        local currentRooms = workspace:FindFirstChild("CurrentRooms")
        if currentRooms then
            
            -- 1. AUTOMATION A: Hijack Room 50 (Portal To The Other Side)
            local room50 = currentRooms:FindFirstChild("50")
            if room50 then
                local figureSetup50 = room50:FindFirstChild("FigureSetup")
                if figureSetup50 then
                    local originalAmbience = figureSetup50:FindFirstChild("Ambience")
                    if originalAmbience and originalAmbience:IsA("Sound") then
                        if originalAmbience.Volume ~= FIGURE_VOLUME then
                            originalAmbience.Volume = FIGURE_VOLUME
                        end
                        if originalAmbience.SoundId ~= customLibraryId then
                            originalAmbience.SoundId = customLibraryId
                            if originalAmbience.IsPlaying then
                                originalAmbience:Stop()
                                originalAmbience:Play()
                            end
                        end
                    end
                end
            end

            -- 2. AUTOMATION B: Hijack Room 100 (AmbienceIntense Only)
            -- Matches selection in image_2c918a.png
            local room100 = currentRooms:FindFirstChild("100")
            if room100 then
                local figureSetup100 = room100:FindFirstChild("FigureSetup")
                if figureSetup100 then
                    local intenseSound = figureSetup100:FindFirstChild("AmbienceIntense")
                    if intenseSound and intenseSound:IsA("Sound") then
                        if intenseSound.Volume ~= FIGURE_VOLUME then
                            intenseSound.Volume = FIGURE_VOLUME
                        end
                        if intenseSound.SoundId ~= customDoor100Id then
                            intenseSound.SoundId = customDoor100Id
                            if intenseSound.IsPlaying then
                                intenseSound:Stop()
                                intenseSound:Play()
                            end
                        end
                    end
                end
            end
            
        end

        -- 3. AUTOMATION C: Global Hijack for SeekMusic
        local targets = {game:GetService("ReplicatedStorage"), workspace, game:GetService("Players").LocalPlayer}
        for _, parent in ipairs(targets) do
            if parent then
                for _, desc in ipairs(parent:GetDescendants()) do
                    if desc:IsA("Sound") and desc.Name == "SeekMusic" then
                        if desc.SoundId ~= customSeekId then
                            desc.SoundId = customSeekId
                            if desc.IsPlaying then
                                desc:Stop()
                                desc:Play()
                            end
                        end
                    end
                end
            end
        end

    end
end)
