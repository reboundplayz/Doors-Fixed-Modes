local function getOrCreateSound(url, fileName)
	if not isfile(fileName .. ".mp3") then
		writefile(fileName .. ".mp3", game:HttpGet(url))
	end
	return getcustomasset(fileName .. ".mp3", true)
end

local function playCustomSound(soundId, maxDuration, playbackSpeed, customVolume)
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = customVolume or 1.3
	sound.PlaybackSpeed = playbackSpeed or 1
	sound.Parent = game:GetService("SoundService")
	sound:Play()
	
	if maxDuration then
		task.delay(maxDuration, function()
			local tween = game:GetService("TweenService"):Create(sound, TweenInfo.new(0.5), {Volume = 0})
			tween:Play()
			tween.Completed:Connect(function()
				sound:Stop()
				sound:Destroy()
			end)
		end)
	else
		task.delay(30, function()
			sound:Destroy()
		end)
	end
end

local function checkForHerb(roomInstance)
	if not roomInstance then return false end
	if roomInstance:FindFirstChild("Green_Herb") then return true end
	if roomInstance:FindFirstChild("Assets") and roomInstance.Assets:FindFirstChild("Green_Herb") then return true end
	for _, desc in ipairs(roomInstance:GetDescendants()) do
		if desc.Name == "Green_Herb" then
			return true
		end
	end
	return false
end

