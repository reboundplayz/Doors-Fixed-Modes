entity.Debug.OnEntitySpawned = function(entityTable)
    print("Entity has spawned")

    local url = "https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/0531.mp3"    
    local file = "quastionmovingsound.mp3"

    if not isfile(file) then
        writefile(file, game:HttpGet(url))
    end

    local model
    repeat
        model = workspace:FindFirstChild("???")
        task.wait()
    until model

    local part = model:FindFirstChildWhichIsA("BasePart")

    if part then
        local sound = Instance.new("Sound")
        sound.SoundId = getcustomasset(file)
        sound.Parent = part

        sound.RollOffMode = Enum.RollOffMode.Inverse
        sound.RollOffMaxDistance = 500
        sound.Volume = 3
        sound.Looped = true

        sound:Play()
    end
end

