--// Services
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

--// Check current room (Banned rooms where entity shouldn't spawn)
local entityModel = true
local latestRoom = game.ReplicatedStorage.GameData.LatestRoom.Value

if game.Workspace:FindFirstChild("SeekMovingNewClone")
or latestRoom == 50
or latestRoom == 100
or (latestRoom >= 90 and latestRoom <= 100) then
    entityModel = false
end

if not entityModel then return end

--// Load asset safely
local assets = game:GetObjects("rbxassetid://13243160197")
if not assets or #assets == 0 then
    warn("A-258 asset failed to load")
    return
end

local root = assets[1]

-- Find Model inside asset
local model = nil

if root:IsA("Model") then
    model = root
else
    for _, v in ipairs(root:GetDescendants()) do
        if v:IsA("Model") then
            model = v
            break
        end
    end
end

if not model then
    warn("No model found inside A-258 asset")
    return
end

model.Parent = workspace
model.Name = "A-258"

local entityInstance = workspace:WaitForChild("A-258")

--// Safely handle lights/visual adjustments
local effects = entityInstance:FindFirstChild("Effects")
if effects then
    local p2 = effects:FindFirstChild("PointLight2")
    if p2 then p2:Destroy() end

    local p1 = effects:FindFirstChild("PointLight")
    if p1 then
        p1.Range = 0
        TweenService:Create(p1, TweenInfo.new(3), {Range = 20}):Play()
    end
end

--// Find a valid base part for physical reference
local part
for _, v in ipairs(entityInstance:GetDescendants()) do
    if v:IsA("BasePart") then
        part = v
        break
    end
end

if not part then
    warn("A-258 has no BasePart")
    return
end

--// Position in room safely
task.wait(1)

local rooms = workspace:WaitForChild("CurrentRooms"):GetChildren()
local currentRoom = rooms[#rooms - 1] 

if currentRoom and currentRoom:FindFirstChild("Parts") and currentRoom.Parts:FindFirstChild("Floor") then
    part.CFrame = currentRoom.Parts.Floor.CFrame + Vector3.new(0, 6, 0)
    print("A-258 spawned successfully in Room " .. currentRoom.Name)
else
    local latestRoomModel = rooms[#rooms]
    if latestRoomModel and latestRoomModel:FindFirstChild("Parts") and latestRoomModel.Parts:FindFirstChild("Floor") then
        part.CFrame = latestRoomModel.Parts.Floor.CFrame + Vector3.new(0, 6, 0)
    end
end

--// ====== DISABLE COLLISIONS ====== --
-- Loops through every piece of the entity and ensures you can walk straight through it
for _, desc in ipairs(entityInstance:GetDescendants()) do
    if desc:IsA("BasePart") then
        desc.CanCollide = false
    end
end
--// ================================ --

--// Cleanup on room change
game.ReplicatedStorage.GameData.LatestRoom.Changed:Connect(function()
    local e = workspace:FindFirstChild("A-258")
    if e then
        e:Destroy()
    end
end)
