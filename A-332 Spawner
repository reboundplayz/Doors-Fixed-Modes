-- Configuration Options
local JUMP_IMAGE = "http://www.roblox.com/asset/?id=13277205847"
local JUMP_SOUND_URL = "https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/A-332Jumpscare.mp3.mpeg"
local SPAWN_SOUND_URL = "https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/A-332Spawn.mp3.mpeg"
local FLICKER_COLOR_1 = Color3.fromRGB(0, 255, 170)
local FLICKER_COLOR_2 = Color3.fromRGB(0, 0, 0)

local function runCustomLightFlicker()
    local roomsFolder = workspace:FindFirstChild("CurrentRooms")
    if not roomsFolder then return end
    
    for _, room in ipairs(roomsFolder:GetChildren()) do
        for _, light in ipairs(room:GetDescendants()) do
            if light:IsA("Light") or light:IsA("SurfaceLight") or light:IsA("PointLight") then
                task.spawn(function()
                    local originalColor = light.Color
                    local originalEnabled = light.Enabled
                    for i = 1, 12 do
                        light.Color = (i % 2 == 0) and FLICKER_COLOR_1 or FLICKER_COLOR_2
                        light.Enabled = (i % 3 ~= 0)
                        task.wait(0.05)
                    end
                    light.Color = originalColor
                    light.Enabled = originalEnabled
                end)
            end
        end
    end
end

local function triggerCustomJumpscare()
    local guiParent = LocalPlayer:FindFirstChild("PlayerGui")
    if not guiParent or guiParent:FindFirstChild("A332Jumpscare") then return end

    local gui = Instance.new("ScreenGui", guiParent)
    gui.Name = "A332Jumpscare"
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999999

    local flash = Instance.new("Frame", gui)
    flash.Size = UDim2.new(1, 0, 1, 0)
    flash.BackgroundColor3 = Color3.new(0, 0, 0)
    flash.BorderSizePixel = 0

    local img = Instance.new("ImageLabel", gui)
    img.AnchorPoint = Vector2.new(0.5, 0.5)
    img.Position = UDim2.new(0.5, 0, 0.5, 0)
    img.Size = UDim2.new(0, 300, 0, 300)
    img.BackgroundTransparency = 1
    img.Image = JUMP_IMAGE

    pcall(function()
        if not isfile("a332jump.mp3") then 
            writefile("a332jump.mp3", game:HttpGet(JUMP_SOUND_URL)) 
        end
    end)

    local sound = Instance.new("Sound", gui)
    sound.SoundId = getcustomasset("a332jump.mp3")
    sound.Volume = 10
    sound:Play()

    TweenService:Create(img, TweenInfo.new(1.0, Enum.EasingStyle.Exponential), {Size = UDim2.new(0, 2000, 0, 2000)}):Play()

    task.spawn(function()
        local start = os.clock()
        while os.clock() - start < 1.0 do
            flash.BackgroundColor3 = (math.random(1, 2) == 1) and FLICKER_COLOR_1 or FLICKER_COLOR_2
            img.Position = UDim2.new(0.5, math.random(-15, 15), 0.5, math.random(-15, 15))
            task.wait(0.01)
        end
        gui:Destroy()
    end)
end

-- ---====== Debug entity ======---

entity:SetCallback("OnSpawned", function()
    print("Entity has spawned")
    runCustomLightFlicker()
    
    -- Plays the custom spawn audio asset globally when entity loads
    pcall(function()
        if not isfile("a332spawn.mp3") then
            writefile("a332spawn.mp3", game:HttpGet(SPAWN_SOUND_URL))
        end
        local spawnSound = Instance.new("Sound", workspace)
        spawnSound.SoundId = getcustomasset("a332spawn.mp3")
        spawnSound.Volume = 4
        spawnSound:Play()
        game:GetService("Debris"):AddItem(spawnSound, 7)
    end)
end)

entity:SetCallback("OnStartMoving", function()
    print("Entity has started moving")
    
    local entityModel = entity.Model
    if entityModel then
        local targetSound = entityModel:FindFirstChild("Sound", true)
        if targetSound and targetSound:IsA("Sound") then
            targetSound.Looped = false 
            
            task.spawn(function()
                while entityModel and entityModel.Parent do
                    task.wait(1)
                    targetSound.Playing = true
                    task.wait(1)
                    targetSound.Playing = false
                    task.wait(1)
                    targetSound.Playing = true
                    task.wait(1)
                    targetSound.Playing = false
                    task.wait(1)
                    targetSound.Playing = true
                    task.wait(1)
                    targetSound.Playing = false
                    task.wait(1)
                    targetSound.Playing = true
                    task.wait(1)
                    targetSound.Playing = false
                end
            end)
        end
    end
end)

