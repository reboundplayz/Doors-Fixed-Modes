-- Helper function to safely execute external loadstrings
local function safeLoadstring(url)
    local success, source = pcall(game.HttpGet, game, url)
    if not success then
        warn("Failed to fetch script from: " .. url)
        return nil
    end
    
    local func, err = loadstring(source)
    if not func then
        warn("Syntax error in script: " .. tostring(err) .. " | URL: " .. url)
        return nil
    end
    
    return func()
end

