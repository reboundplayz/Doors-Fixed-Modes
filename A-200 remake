---====== Debug entity ======---

entity:SetCallback("OnSpawned", function()
    print("Entity has spawned")
    
    -- Play spawn sound using local filesystem
    task.spawn(function()
        local fileName = "a200spawn.mp3"
        local audioUrl = "https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/A-300_Entity_Spawning.mp3.mpeg"
        
        -- Check and save the audio locally if it does not exist
        if not isfile(fileName) then
            local success, content = pcall(function()
                return game:HttpGet(audioUrl)
            end)
            if success and content then
                writefile(fileName, content)
            else
                warn("Failed to download spawn sound.")
                return
            end
        end
        
        -- Create and configure the sound in the Workspace
        local spawnSound = Instance.new("Sound")
        spawnSound.Name = "A200SpawnSound"
        spawnSound.Volume = 2
        spawnSound.SoundId = getcustomasset(fileName)
        spawnSound.Parent = workspace
        
        spawnSound:Play()
        
        -- Clean up after sound finishes playing
        spawnSound.Ended:Connect(function()
            spawnSound:Destroy()
        end)
    end)
end)

