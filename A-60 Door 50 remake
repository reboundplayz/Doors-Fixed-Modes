-- === CORE EXECUTION INITIALIZER ===
local function initEntity()
    entityModel = game:GetObjects(Config.Asset)[1]
    entityModel.Name = Config.Name
    entityModel.Parent = Workspace
    
    for _, part in ipairs(entityModel:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Massless = true
        end
    end
    
    -- Fixed: Always forces spawn at Room Entrance + moves him back several studs out of sight
    local entranceCFrame = getRoomEntranceCFrame()
    local hiddenSpawnCFrame = entranceCFrame + (entranceCFrame.LookVector * Config.SpawnBehindOffset) + Vector3.new(0, Config.HeightOffset, 0)
    entityModel:PivotTo(hiddenSpawnCFrame)

    runOnSpawnedEffects()
    startDamageThread(entityModel)
    monitorRoomTraverse(entityModel)

    -- Delay buffer while hidden out of bounds
    task.wait(Config.SpawnDelay)

    -- === RUN PATROL LOOPS ===
    for i = 1, Config.PatrolLoops do
        print("Starting patrol loop count: " .. i)
        local success = runPatrolSequence()
        if not success then break end
    end

    -- === DESPAWN SEQUENCE ===
    print("Entity is despawning")
    if entityModel then
        entityModel:Destroy()
    end
    runOnDespawnedEffects()
end

initEntity()
