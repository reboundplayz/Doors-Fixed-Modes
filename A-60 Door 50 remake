-- === ENTITY CONFIGURATION ===
local Config = {
    Name = "A-60",
    Asset = "rbxassetid://93702916339224", 
    HeightOffset = 4, 
    Speed = 350, 
    DamageRange = 40,
    DamageAmount = 125,
    PatrolLoops = 3,
    SpawnDelay = 2.5,
    SpawnBehindOffset = 25 -- How many studs behind the entrance he spawns hidden
}

local destroyedRooms = {}
local entityModel = nil

local function getRoomEntranceCFrame()
    local rooms = Workspace:FindFirstChild("CurrentRooms")
    if rooms then
        local room50 = rooms:FindFirstChild("50") or rooms:FindFirstChild("Room50")
        if room50 and room50:FindFirstChild("RoomStart") then
            return room50.RoomStart.CFrame
        end
    end
    return CFrame.new(0, 0, 0)
end

-- === DAMAGE & PROXIMITY CHECKER ===
local function startDamageThread(entity)
