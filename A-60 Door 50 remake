                                    writefile(fileName .. '.mp3', game:HttpGet(url))
                                end
                                local sound = Instance.new('Sound')
                                sound.SoundId = (getcustomasset or getsynasset)(fileName .. '.mp3')
                                return sound
                            end

                            local function runJumpscare()
                                print('Executing Jumpscare...')
                                local screenGui = Instance.new('ScreenGui', localPlayer:WaitForChild('PlayerGui'))
                                screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

                                local fullTemplate = Instance.new('ImageLabel', screenGui)
                                fullTemplate.Name = 'Full'
                                fullTemplate.BackgroundTransparency = 1
                                fullTemplate.Position = UDim2.new(-0.0609865487, 0, -0.224358946, 0)
                                fullTemplate.Size = UDim2.new(1.12197304, 0, 1.44743586, 0)
                                fullTemplate.ImageTransparency = 1

                                local jumpscareEnd = Instance.new('ImageLabel', screenGui)
                                jumpscareEnd.Name = 'JumpscareEnd'
                                jumpscareEnd.BackgroundTransparency = 1
                                
                                local defaultPosition = UDim2.new(0.468161434, 0, 0.455128193, 0)
                                local defaultSize = UDim2.new(0.0636771321, 0, 0.0884615406, 0)
                                
                                jumpscareEnd.Position = defaultPosition
                                jumpscareEnd.Size = defaultSize
                                jumpscareEnd.ImageColor3 = Color3.fromRGB(255, 0, 4)

                                local finalFace = JUMPSCARE_IMAGES[math.random(1, #JUMPSCARE_IMAGES)]
                                local scareSound = loadCustomSound(JUMPSCARE_AUDIO_URL, AUDIO_FILE_NAME)
                                scareSound.Parent = Workspace
                                scareSound.Volume = 6

                                local colorCorrection = Instance.new('ColorCorrectionEffect', Lighting)
                                scareSound:Play()

                                TweenService:Create(colorCorrection, TweenInfo.new(0.5), {
                                    Brightness = 0.2,
                                    Contrast = 0.2,
                                    Saturation = -0.2,
                                    TintColor = Color3.fromRGB(255, 0, 4),
                                }):Play()

                                local cycling = true
                                task.spawn(function()
                                    local rng = Random.new()
                                    while cycling do
                                        jumpscareEnd.Image = JUMPSCARE_IMAGES[math.random(1, #JUMPSCARE_IMAGES)]
                                        jumpscareEnd.Position = UDim2.new(rng:NextNumber(0.1, 0.8), 0, rng:NextNumber(0.1, 0.8), 0)
                                        jumpscareEnd.Size = UDim2.new(0.15, 0, 0.2, 0)
                                        jumpscareEnd.Rotation = rng:NextNumber(-180, 180)
                                        RunService.Heartbeat:Wait()
                                        task.wait(math.random(0, 1) / 100) 
