        while entity and entity.Parent do
            local character = localPlayer.Character
            local primaryPart = entity.PrimaryPart or entity:FindFirstChildWhichIsA("BasePart")
            
            if character and character:FindFirstChild("HumanoidRootPart") and primaryPart then
                local hrp = character.HumanoidRootPart
                local distance = (hrp.Position - primaryPart.Position).Magnitude
                
                if distance <= Config.DamageRange then
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        local newHealth = humanoid.Health - Config.DamageAmount
                        
                        if newHealth <= 0 then
                            print("Entity has killed the player")
                            
                            local JUMPSCARE_IMAGES = {
                                "rbxassetid://124887042598105", "rbxassetid://17206102313", "rbxassetid://70579374116007",
                                "rbxassetid://138308786963210", "rbxassetid://107134253330756", "rbxassetid://138806755053926",
                                "rbxassetid://83021870514358", "rbxassetid://133426336717195", "rbxassetid://129072942715997",
                                "rbxassetid://81268093333511"
                            }

                            local JUMPSCARE_AUDIO_URL = "https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/HAIR%20JUMPSCARE%20(1)%20(1).mp3"
                            local AUDIO_FILE_NAME = "asixtyScareremakeOmg"
                            local JUMPSCARE_DURATION = 0.85 

                            local function loadCustomSound(url, fileName)
