                                end)

                                task.wait(JUMPSCARE_DURATION)
                                cycling = false 
                                
                                jumpscareEnd.Image = finalFace
                                jumpscareEnd.Position = defaultPosition
                                jumpscareEnd.Size = defaultSize
                                jumpscareEnd.Rotation = 0

                                TweenService:Create(jumpscareEnd, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
