-- Defines colors based on the exact name of the entity being crucified
local function GetEntityColor(entityName)
    if entityName == "Smiler" then
        return Color3.fromRGB(255, 0, 0)       
    elseif entityName == "WH1T3" then
        return Color3.fromRGB(0, 0, 255)   
    elseif entityName == "Blink" then
        return Color3.fromRGB(232, 14, 225)  
    elseif entityName == "Common Sense" then
        return Color3.fromRGB(128, 128, 128)     
    elseif entityName == "HungerMoving" then
        return Color3.fromRGB(79, 0, 0)
    elseif entityName == "Silence" then
        return Color3.fromRGB(255, 255, 255)
    else
        return Color3.fromRGB(79, 0, 0)        
    end
end
